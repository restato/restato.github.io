# Firebase Configuration
# Get these values from Firebase Console: https://console.firebase.google.com/
PUBLIC_FIREBASE_API_KEY=your_api_key_here
PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
PUBLIC_FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
PUBLIC_FIREBASE_PROJECT_ID=your-project-id
PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
PUBLIC_FIREBASE_APP_ID=your_app_id
PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional Google Analytics measurement ID. Analytics loads only after explicit consent.
PUBLIC_GA_ID=

# Keep false until AdSense approval is confirmed. Client and the relevant slot ID are also required.
PUBLIC_ADSENSE_ENABLED=false
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT_TOOL=
PUBLIC_ADSENSE_SLOT_CATALOG=
