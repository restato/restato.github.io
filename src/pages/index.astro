---
import MainLayout from '../layouts/MainLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';
import {
  HeroSection,
  RecentPostsHeader,
  NoPostsMessage,
  PopularToolsSection,
  ProjectsSection
} from '../components/HomeContent';
import { projectEnglishRoutes } from '../lib/blogRoutes';

const routes = projectEnglishRoutes(
  await getCollection('blog', ({ data }) => !data.draft),
)
  .sort((a, b) => b.post.data.date.valueOf() - a.post.data.date.valueOf())
  .slice(0, 6);
---

<MainLayout title="Restato | Developer Blog">
  <div class="fc-page fc-content">
    <HeroSection client:idle />
    <PopularToolsSection client:visible />

    <section class="border-b border-[var(--border-subtle)] py-10" aria-labelledby="recent-notes-heading">
      <RecentPostsHeader client:idle />

      {routes.length > 0 ? (
        <div class="grid gap-4 md:grid-cols-2">
          {routes.map(({ post, pathname }) => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              slug={post.slug}
              href={pathname}
              tags={post.data.tags}
              image={post.data.image}
            />
          ))}
        </div>
      ) : (
        <NoPostsMessage client:idle />
      )}
    </section>

    <div class="py-10">
      <ProjectsSection client:visible />
    </div>
  </div>
</MainLayout>
