---
import MainLayout from '../../../layouts/MainLayout.astro';
import PageShell from '../../../components/ui/PageShell.astro';

const pageTitle = 'PasteDock Privacy Policy';
const pageDescription = 'Privacy Policy for PasteDock purchases and support.';
const canonical = '/projects/pastedock/privacy';
const lastUpdated = 'February 16, 2026';
const pricingUrl = '/projects/pastedock/pricing';
---

<MainLayout title={pageTitle} description={pageDescription} canonical={canonical}>
  <PageShell size="reading">
    <article class="fc-prose">
      <nav class="fc-tool-breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/projects">Projects</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/projects/pastedock">PasteDock</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">Privacy</li>
        </ol>
      </nav>

      <header class="fc-page-header">
        <p class="fc-eyebrow">PasteDock policy</p>
        <h1>Privacy Policy</h1>
        <p class="fc-chip w-fit text-[var(--accent)]">Last updated: {lastUpdated}</p>
        <p class="text-sm">Pricing: <a href={pricingUrl}>US$4.99 one-time</a></p>
      </header>

      <div class="space-y-10">
      <section>
        <h2>1. Data Controller</h2>
        <p>For PasteDock purchase and support operations, the data controller is <strong>Restato (individual seller)</strong>. Contact: <a href="mailto:direcision@gmail.com">direcision@gmail.com</a>.</p>
      </section>

      <section>
        <h2>2. Data We Collect</h2>
        <ul class="list-disc pl-5 space-y-2">
          <li>Purchase and billing details processed by Paddle (for example, transaction ID, payment status, purchase email).</li>
          <li>Support communication details you provide when contacting us.</li>
          <li>Basic website analytics data used for site performance and traffic understanding.</li>
        </ul>
      </section>

      <section>
        <h2>3. How We Use Data</h2>
        <ul class="list-disc pl-5 space-y-2">
          <li>Process orders and confirm purchases.</li>
          <li>Provide support and respond to refund requests.</li>
          <li>Prevent abuse and comply with legal/accounting obligations.</li>
        </ul>
      </section>

      <section>
        <h2>4. Data Sharing</h2>
        <p>We share data only with essential providers, including Paddle for payment processing, and only as needed for service delivery and legal compliance.</p>
      </section>

      <section>
        <h2>5. Data Retention</h2>
        <p>Data is retained only for as long as necessary for support, accounting, legal compliance, and dispute handling.</p>
      </section>

      <section>
        <h2>6. Your Rights</h2>
        <p>You may request access, correction, or deletion of personal data where legally applicable by contacting <a href="mailto:direcision@gmail.com">direcision@gmail.com</a>.</p>
      </section>

      <section>
        <h2>7. Security</h2>
        <p>We apply reasonable administrative and technical safeguards to protect personal data.</p>
      </section>

      <section>
        <h2>8. Changes to this Policy</h2>
        <p>This policy may be updated. The latest version is always available at this URL with an updated date.</p>
      </section>
      </div>
    </article>
  </PageShell>
</MainLayout>
