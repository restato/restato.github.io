---
import MainLayout from '../../../layouts/MainLayout.astro';
import PageShell from '../../../components/ui/PageShell.astro';

const pageTitle = 'PasteDock Pricing | US$4.99 One-Time';
const pageDescription = 'PasteDock pricing: US$4.99 one-time purchase for macOS 14+.';
const canonical = '/projects/pastedock/pricing';
const lastUpdated = 'February 16, 2026';
const priceDisplay = 'US$4.99';
const supportEmail = 'direcision@gmail.com';
const termsUrl = '/projects/pastedock/terms';
const privacyUrl = '/projects/pastedock/privacy';
const refundUrl = '/projects/pastedock/refund';
const productUrl = '/projects/pastedock';
---

<MainLayout title={pageTitle} description={pageDescription} canonical={canonical}>
  <PageShell size="reading">
    <nav class="fc-tool-breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/projects">Projects</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={productUrl}>PasteDock</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page">Pricing</li>
      </ol>
    </nav>

    <header class="fc-page-header">
      <p class="fc-eyebrow">PasteDock</p>
      <h1>PasteDock Pricing</h1>
      <p class="fc-chip w-fit text-[var(--accent)]">Last updated: {lastUpdated}</p>
    </header>

    <div class="space-y-6">
      <article class="fc-surface fc-surface-padding-md">
        <p class="mb-2 text-sm uppercase tracking-wide text-[var(--accent)]">One-time purchase</p>
        <h2 class="text-4xl font-bold mb-2">{priceDisplay}</h2>
        <p class="mb-4 text-[var(--text-muted)]">Single payment. No subscription.</p>
        <p class="text-sm text-[var(--text-muted)]">Checkout will be provided through Paddle once domain approval is complete.</p>
      </article>

      <article class="fc-surface p-6 space-y-3">
        <h2 class="text-xl font-semibold">What is included</h2>
        <ul class="list-disc pl-5 text-[var(--text-muted)] space-y-2">
          <li>Full access to PasteDock for macOS 14+</li>
          <li>Updates according to current release policy</li>
          <li>Email support at <a class="text-[var(--brand)] underline" href={`mailto:${supportEmail}`}>{supportEmail}</a></li>
        </ul>
      </article>

      <article class="fc-surface p-6 space-y-3">
        <h2 class="text-xl font-semibold">Refund</h2>
        <p class="text-[var(--text-muted)]">Full refund is available within 7 days of purchase. See <a class="text-[var(--brand)] underline" href={refundUrl}>Refund Policy</a> for details.</p>
      </article>

      <article class="fc-surface p-6 space-y-3">
        <h2 class="text-xl font-semibold">Legal and support</h2>
        <p class="text-[var(--text-muted)]">
          <a class="text-[var(--brand)] underline" href={termsUrl}>Terms</a>
          <span class="mx-2">·</span>
          <a class="text-[var(--brand)] underline" href={privacyUrl}>Privacy</a>
          <span class="mx-2">·</span>
          <a class="text-[var(--brand)] underline" href={refundUrl}>Refund</a>
          <span class="mx-2">·</span>
          <a class="text-[var(--brand)] underline" href={`mailto:${supportEmail}`}>Contact support</a>
        </p>
      </article>
    </div>
  </PageShell>
</MainLayout>
