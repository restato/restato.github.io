---
import MainLayout from '../../../layouts/MainLayout.astro';
import PageShell from '../../../components/ui/PageShell.astro';

const pageTitle = 'PasteDock Terms of Service';
const pageDescription = 'Terms of Service for purchasing and using PasteDock.';
const canonical = '/projects/pastedock/terms';
const lastUpdated = 'February 16, 2026';
const pricingUrl = '/projects/pastedock/pricing';
---

<MainLayout title={pageTitle} description={pageDescription} canonical={canonical}>
  <PageShell size="reading">
    <article class="fc-prose">
      <nav class="fc-tool-breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/projects">Projects</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/projects/pastedock">PasteDock</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">Terms</li>
        </ol>
      </nav>

      <header class="fc-page-header">
        <p class="fc-eyebrow">PasteDock policy</p>
        <h1>Terms of Service</h1>
        <p class="fc-chip w-fit text-[var(--accent)]">Last updated: {lastUpdated}</p>
        <p class="text-sm">Pricing: <a href={pricingUrl}>US$4.99 one-time</a></p>
      </header>

      <div class="space-y-10">
        <section>
          <h2>1. Seller Information</h2>
          <p>PasteDock is sold by <strong>Restato (individual seller)</strong>. For support, contact <a href="mailto:direcision@gmail.com">direcision@gmail.com</a>.</p>
        </section>

        <section>
          <h2>2. Product Scope</h2>
          <p>PasteDock is a utility application for macOS 14+ distributed through the official download page and release artifacts.</p>
        </section>

        <section>
          <h2>3. License Grant</h2>
          <p>After a valid purchase, you receive a non-exclusive, non-transferable license to use PasteDock. You may not resell, redistribute, or sublicense the application binaries.</p>
        </section>

        <section>
          <h2>4. Payments</h2>
          <p>Payments are processed by Paddle. Taxes and payment handling are applied according to Paddle checkout settings and local legal requirements.</p>
        </section>

        <section>
          <h2>5. Refunds</h2>
          <p>Please refer to the dedicated <a href="/projects/pastedock/refund">Refund Policy</a>.</p>
        </section>

        <section>
          <h2>6. Warranty and Liability</h2>
          <p>PasteDock is provided "as is" without warranties of any kind to the extent permitted by law. To the maximum extent permitted by law, liability is limited to the amount paid for the product.</p>
        </section>

        <section>
          <h2>7. Changes to Terms</h2>
          <p>These terms may be updated from time to time. The latest version is always published at this URL with an updated effective date.</p>
        </section>

        <section>
          <h2>8. Governing Law</h2>
          <p>These terms are governed by the laws applicable in the seller's principal place of residence, except where mandatory consumer protection laws in your jurisdiction require otherwise.</p>
        </section>
      </div>
    </article>
  </PageShell>
</MainLayout>
