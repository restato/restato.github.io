---
import MainLayout from '../../../layouts/MainLayout.astro';
import PageShell from '../../../components/ui/PageShell.astro';

const pageTitle = 'PasteDock Refund Policy';
const pageDescription = 'Refund Policy for PasteDock purchases.';
const canonical = '/projects/pastedock/refund';
const lastUpdated = 'February 16, 2026';
const pricingUrl = '/projects/pastedock/pricing';
---

<MainLayout title={pageTitle} description={pageDescription} canonical={canonical} lang="en" lockLanguage={true}>
  <PageShell size="reading">
    <article class="fc-prose">
      <nav class="fc-tool-breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/projects">Projects</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/projects/pastedock">PasteDock</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">Refund</li>
        </ol>
      </nav>

      <header class="fc-page-header">
        <p class="fc-eyebrow">PasteDock policy</p>
        <h1>Refund Policy</h1>
        <p class="fc-chip w-fit text-[var(--accent)]">Last updated: {lastUpdated}</p>
        <p class="text-sm">Pricing: <a href={pricingUrl}>US$4.99 one-time</a></p>
      </header>

      <div class="space-y-10">
        <section>
          <h2>1. Eligibility</h2>
          <p>You can request a full refund within <strong>7 days</strong> of purchase.</p>
        </section>

        <section>
          <h2>2. How to Request</h2>
          <p>Send your request to <a href="mailto:direcision@gmail.com">direcision@gmail.com</a> and include your purchase email and transaction reference.</p>
        </section>

        <section>
          <h2>3. Processing</h2>
          <p>Refunds are processed through Paddle to the original payment method. Processing times may vary based on your payment provider or bank.</p>
        </section>

        <section>
          <h2>4. Exceptions</h2>
          <p>We may deny refund requests in cases of abuse or fraud. This policy does not limit mandatory consumer rights provided by applicable law.</p>
        </section>

        <section>
          <h2>5. Contact</h2>
          <p>For any refund questions, contact <a href="mailto:direcision@gmail.com">direcision@gmail.com</a>.</p>
        </section>
      </div>
    </article>
  </PageShell>
</MainLayout>
