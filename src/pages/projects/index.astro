---
import MainLayout from '../../layouts/MainLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import PageShell from '../../components/ui/PageShell.astro';
import { projects } from '../../data/projects';

const pageDescription = "A collection of personal projects, practical apps, and tools including 동네변화, 바른한끼, Arc Note, Local Price Extractor, RoomFit 3D, PasteDock, Quick Issue, and JobWorld Kids Planner.";
---

<MainLayout title="Projects | Restato" description={pageDescription} lang="en" lockLanguage={true}>
  <PageShell size="content">
    <PageHeader
      eyebrow="Restato"
      title="Projects"
      description="Apps and tools I have built"
    />

    <div class="fc-surface overflow-hidden">
      <ul class="m-0 grid list-none p-0 md:grid-cols-2">
        {projects.map((project) => (
          <li class="border-b border-[var(--border-subtle)] md:border-r">
            <a
              href={project.url ?? `/projects/${project.slug}`}
              target={project.url ? '_blank' : undefined}
              rel={project.url ? 'noreferrer' : undefined}
              class="group relative flex min-h-28 items-center gap-4 px-5 py-4 transition-colors hover:bg-[var(--surface-soft)]"
            >
              {project.badge && (
                <span class="fc-chip absolute right-3 top-3 text-xs text-[var(--accent)]">
                  {project.badge}
                </span>
              )}
              <span class="w-12 shrink-0 text-center text-4xl" aria-hidden="true">
                {project.icon}
              </span>
              <span class="min-w-0 flex-1">
                <span class="block font-bold text-[var(--text-primary)] group-hover:text-[var(--brand)]">
                  {project.title}
                </span>
                <span class="mt-1 block text-sm text-[var(--text-muted)]">
                  {project.description}
                </span>
              </span>
              <span class="text-[var(--text-muted)]" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </PageShell>
</MainLayout>
