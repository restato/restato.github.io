---
import MainLayout from '../../layouts/MainLayout.astro';
import Roulette from '../../components/Roulette';
import PageHeader from '../../components/ui/PageHeader.astro';
import PageShell from '../../components/ui/PageShell.astro';
---

<MainLayout title="룰렛 | Restato" description="커스텀 항목으로 돌리는 랜덤 룰렛 게임">
  <PageShell size="wide">
      <nav class="fc-tool-breadcrumb" aria-label="프로젝트">
        <ol>
          <li><a href="/projects">프로젝트</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">룰렛</li>
        </ol>
      </nav>
      <PageHeader
        eyebrow="🎡 Mini game"
        title="룰렛"
        description="커스텀 항목을 추가하고 랜덤으로 선택하세요!"
      />

      <!-- Roulette Component -->
      <section class="fc-surface fc-surface-padding-md" aria-label="룰렛">
        <Roulette client:load />
      </section>

      <!-- Info -->
      <section class="fc-tool-instructions fc-prose">
        <div>
        <h2 class="text-lg font-bold mb-4">💡 사용법</h2>
        <ul class="space-y-2 text-[var(--color-text-muted)]">
          <li>• 오른쪽 패널에서 항목을 추가/삭제할 수 있어요</li>
          <li>• 최소 2개, 최대 12개의 항목을 추가할 수 있어요</li>
          <li>• "돌리기" 버튼을 클릭하면 룰렛이 돌아가요</li>
          <li>• 당첨 결과는 애니메이션과 함께 표시됩니다</li>
        </ul>
        </div>
      </section>
  </PageShell>
</MainLayout>
