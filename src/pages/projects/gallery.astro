---
import MainLayout from '../../layouts/MainLayout.astro';

// Local project images keep the gallery and its visual evidence available offline.
const images = [
  { src: '/images/projects/jobworld/hero.png', alt: '잡월드 키즈 프로젝트 화면', title: 'Sample Image 1' },
  { src: '/images/projects/jobworld/feature-history.png', alt: '잡월드 키즈 체험 기록 화면', title: 'Sample Image 2' },
  { src: '/images/projects/quick-issue/screenshot-1.png', alt: 'Quick Issue 프로젝트 화면', title: 'Sample Image 3' },
  { src: '/images/projects/quick-issue/screenshot-2.png', alt: 'Quick Issue 이슈 화면', title: 'Sample Image 4' },
  { src: '/images/projects/roomfit-3d/gallery-detail.png', alt: 'RoomFit 3D 상세 화면', title: 'Sample Image 5' },
  { src: '/images/projects/pastedock/hero.png', alt: 'PasteDock 프로젝트 화면', title: 'Sample Image 6' },
];
---

<MainLayout title="갤러리 | Restato" description="사진 갤러리">
  <div class="fc-page fc-content">
    <nav class="fc-tool-breadcrumb" aria-label="이동 경로">
      <ol>
        <li><a href="/projects">프로젝트</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page">갤러리</li>
      </ol>
    </nav>

    <header class="fc-page-header">
      <p class="fc-eyebrow">Photo collection</p>
      <h1>📷 갤러리</h1>
      <p class="fc-page-description">사진 모음</p>
    </header>

    <section aria-label="사진 모음">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {images.map((image, index) => (
          <button
            type="button"
            class="fc-surface group relative aspect-[4/3] overflow-hidden p-0 text-left"
            data-gallery-item
            data-index={index}
            aria-label={`${image.title} 크게 보기`}
          >
            <img
              src={image.src}
              alt={image.alt}
              class="h-full w-full object-cover"
              loading="lazy"
            />
            <span class="absolute inset-x-0 bottom-0 bg-[var(--surface-raised)] p-3 text-sm font-medium text-[var(--text-primary)]">
              {image.title}
            </span>
          </button>
        ))}
      </div>

      {images.length === 0 && (
        <div class="fc-empty-state">
          <div class="text-6xl" aria-hidden="true">📷</div>
          <h2>아직 사진이 없습니다</h2>
          <p>public/images 폴더에 사진을 추가하세요</p>
        </div>
      )}
    </section>

    <section class="fc-surface fc-surface-padding-md" aria-labelledby="gallery-help-title">
      <h2 id="gallery-help-title" class="mb-4 text-lg font-bold">💡 사진 추가하기</h2>
      <p class="text-[var(--text-muted)]">
        <code class="rounded bg-[var(--surface-soft)] px-2 py-1 text-[var(--accent)]">public/images/gallery/</code> 폴더에 사진을 추가하고,
        이 페이지의 images 배열을 업데이트하세요.
      </p>
    </section>
  </div>

  <div
    id="gallery-dialog"
    class="fixed inset-0 z-50 items-center justify-center bg-[var(--surface-page)]/95 p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="gallery-dialog-title"
    hidden
  >
    <h2 id="gallery-dialog-title" class="sr-only">이미지 크게 보기</h2>
    <button
      type="button"
      class="fc-button fc-button-secondary absolute right-4 top-4 h-11 w-11 p-0 text-2xl"
      data-gallery-close
      aria-label="닫기"
    >
      &times;
    </button>
    <button
      type="button"
      class="fc-button fc-button-secondary absolute left-4 top-1/2 h-11 w-11 -translate-y-1/2 p-0 text-2xl"
      data-gallery-previous
      aria-label="이전 이미지"
    >
      &#8249;
    </button>
    <button
      type="button"
      class="fc-button fc-button-secondary absolute right-4 top-1/2 h-11 w-11 -translate-y-1/2 p-0 text-2xl"
      data-gallery-next
      aria-label="다음 이미지"
    >
      &#8250;
    </button>
    <img id="gallery-dialog-image" src="" alt="" class="max-h-[85vh] max-w-[85vw] object-contain" />
  </div>
</MainLayout>

<script define:vars={{ images }}>
  const dialog = document.getElementById('gallery-dialog');
  const dialogImage = document.getElementById('gallery-dialog-image');
  const closeButton = dialog?.querySelector('[data-gallery-close]');
  const previousButton = dialog?.querySelector('[data-gallery-previous]');
  const nextButton = dialog?.querySelector('[data-gallery-next]');
  let currentIndex = 0;
  let opener = null;

  document.querySelectorAll('[data-gallery-item]').forEach((element) => {
    element.addEventListener('click', () => {
      opener = element;
      currentIndex = Number(element.getAttribute('data-index'));
      showImage(currentIndex);
      dialog?.removeAttribute('hidden');
      dialog?.classList.add('flex');
      closeButton?.focus();
    });
  });

  closeButton?.addEventListener('click', closeDialog);
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) closeDialog();
  });
  previousButton?.addEventListener('click', () => {
    currentIndex = (currentIndex - 1 + images.length) % images.length;
    showImage(currentIndex);
  });
  nextButton?.addEventListener('click', () => {
    currentIndex = (currentIndex + 1) % images.length;
    showImage(currentIndex);
  });

  document.addEventListener('keydown', (event) => {
    if (dialog?.hasAttribute('hidden')) return;
    if (event.key === 'Escape') {
      event.preventDefault();
      closeDialog();
    }
    if (event.key === 'ArrowLeft') previousButton?.click();
    if (event.key === 'ArrowRight') nextButton?.click();
    if (event.key === 'Tab') {
      const focusable = [...dialog.querySelectorAll(
        'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
      )].filter((element) => !element.hasAttribute('hidden'));
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    }
  });

  function showImage(index) {
    if (!(dialogImage instanceof HTMLImageElement)) return;
    dialogImage.src = images[index].src;
    dialogImage.alt = images[index].alt;
  }

  function closeDialog() {
    dialog?.classList.remove('flex');
    dialog?.setAttribute('hidden', '');
    opener?.focus();
  }
</script>
