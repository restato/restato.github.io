---
import MainLayout from '../../layouts/MainLayout.astro';
import SlotMachine from '../../components/SlotMachine';
import PageHeader from '../../components/ui/PageHeader.astro';
import PageShell from '../../components/ui/PageShell.astro';
---

<MainLayout title="슬롯머신 | Restato" description="행운의 777을 노려보세요!">
  <PageShell size="content">
      <nav class="fc-tool-breadcrumb" aria-label="게임센터">
        <ol>
          <li><a href="/projects/games">게임센터</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">슬롯머신</li>
        </ol>
      </nav>
      <PageHeader
        eyebrow="🎰 Mini game"
        title="슬롯머신"
        description="행운의 777을 노려보세요! 같은 심볼 3개를 맞추면 대박!"
      />

      <!-- Game Component -->
      <section class="fc-surface fc-surface-padding-md" aria-label="슬롯머신">
        <SlotMachine client:load />
      </section>

      <!-- Info -->
      <section class="fc-tool-instructions fc-prose">
        <div>
        <h2 class="text-lg font-bold mb-4">💡 게임 방법</h2>
        <ul class="space-y-2 text-[var(--color-text-muted)]">
          <li>• 베팅 금액을 설정하고 SPIN 버튼을 눌러주세요</li>
          <li>• 같은 심볼 3개가 나오면 배당률에 따라 코인을 획득해요</li>
          <li>• 2개가 일치해도 1.5배의 코인을 받을 수 있어요</li>
          <li>• 777이 나오면 100배 잭팟!</li>
        </ul>
        </div>
      </section>
  </PageShell>
</MainLayout>
