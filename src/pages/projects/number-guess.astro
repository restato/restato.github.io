---
import MainLayout from '../../layouts/MainLayout.astro';
import NumberGuess from '../../components/NumberGuess';
import PageHeader from '../../components/ui/PageHeader.astro';
import PageShell from '../../components/ui/PageShell.astro';
---

<MainLayout title="숫자 맞추기 | Restato" description="1-100 사이 숫자를 맞춰보세요">
  <PageShell size="content">
      <nav class="fc-tool-breadcrumb" aria-label="게임센터">
        <ol>
          <li><a href="/projects/games">게임센터</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">숫자 맞추기</li>
        </ol>
      </nav>
      <PageHeader
        eyebrow="🔢 Mini game"
        title="숫자 맞추기"
        description="Up & Down 게임! 힌트를 보고 숫자를 맞춰보세요!"
      />

      <!-- Game Component -->
      <section class="fc-surface fc-surface-padding-md" aria-label="숫자 맞추기">
        <NumberGuess client:load />
      </section>

      <!-- Info -->
      <section class="fc-tool-instructions fc-prose">
        <div>
        <h2 class="text-lg font-bold mb-4">💡 게임 방법</h2>
        <ul class="space-y-2 text-[var(--color-text-muted)]">
          <li>• 난이도를 선택하세요 (쉬움/보통/어려움)</li>
          <li>• 숫자를 입력하면 UP/DOWN 힌트가 표시됩니다</li>
          <li>• 제한된 횟수 안에 정답을 맞춰야 해요</li>
          <li>• 정답에 가까울수록 초록색으로 표시됩니다</li>
        </ul>
        </div>
      </section>
  </PageShell>
</MainLayout>
