<MainLayout
  title="온라인 도구 | Restato"
  description="유용한 웹 도구 모음 - QR 코드 생성기, 비밀번호 생성기, 색상 변환기, 단위 변환기, 개발자 도구, 디자이너 도구, 마케터 도구 등"
  robots="noindex, follow"
  canonical="https://restato.github.io/en/tools/"
>
  <Fragment slot="head">
    <noscript>
      <meta http-equiv="refresh" content="0;url=/en/tools/" />
    </noscript>
  </Fragment>

  <div class="fc-page fc-content">
    <!-- Header with i18n support -->
    <ToolsPageHeader client:load />

    <!-- Search -->
    <div class="fc-surface fc-surface-padding-md mb-6">
      <ToolSearch client:load />
    </div>

    <!-- Recent Tools -->
    <RecentTools client:load className="mb-8" />

    <!-- Tools Grid with i18n support -->
    <ToolsGrid client:load lang="en" tools={tools} categories={categories} />

    <!-- Info with i18n support -->
    <ToolsPageInfo client:load />
  </div>

  <!-- Redirect to language-specific URL -->
  <script is:inline>
    (function() {
      const supportedLangs = ['ko', 'en', 'ja'];
      const currentPath = window.location.pathname;

      // Only redirect if we're on the non-language-prefixed path
      if (currentPath === '/tools' || currentPath === '/tools/') {
        // Get language preference
        let lang = localStorage.getItem('lang');
        if (!lang || !supportedLangs.includes(lang)) {
          const browserLang = navigator.language.split('-')[0];
          lang = supportedLangs.includes(browserLang) ? browserLang : 'en';
        }

        // Redirect to language-specific URL
        const newPath = '/' + lang + '/tools';
        window.location.replace(newPath);
      }
    })();
  </script>
</MainLayout>
