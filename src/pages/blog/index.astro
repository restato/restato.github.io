---
import MainLayout from '../../layouts/MainLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import BlogTagNav from '../../components/BlogTagNav.astro';
import PageShell from '../../components/ui/PageShell.astro';
import { getCollection } from 'astro:content';
import { getRankedBlogTagEntries } from '../../lib/blogTags';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const rankedTags = getRankedBlogTagEntries(
  posts.map(post => post.data.tags),
);
---

<MainLayout title="Blog | Restato" description="Development logs, learnings, and thoughts." lang="en">
  <PageShell size="content">
    <header class="fc-page-header max-w-2xl">
      <p class="fc-eyebrow">Restato journal</p>
      <h1>Blog</h1>
      <p class="fc-page-description">
        Development logs, learnings, thoughts, and coding adventures.
      </p>
    </header>

    {rankedTags.length > 0 && (
      <BlogTagNav
        entries={rankedTags}
        label="Blog tags"
        showMoreLabel="Show more"
        showLessLabel="Show less"
      />
    )}

    {posts.length > 0 ? (
      <div class="grid gap-5 md:grid-cols-2">
        {posts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            slug={post.slug}
            tags={post.data.tags}
            image={post.data.image}
          />
        ))}
      </div>
    ) : (
      <div class="fc-empty-state">
        <h2>No posts yet</h2>
        <p>The first post will be up soon!</p>
      </div>
    )}

    {posts.length > 0 && (
      <p class="mt-8 border-t border-[var(--border-subtle)] pt-5 text-sm text-[var(--text-muted)]">
        {posts.length} posts
      </p>
    )}
  </PageShell>
</MainLayout>
