---
import MainLayout from '../../layouts/MainLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import BlogTagNav from '../../components/BlogTagNav.astro';
import PageShell from '../../components/ui/PageShell.astro';
import { getCollection } from 'astro:content';
import { getRankedBlogTagEntries } from '../../lib/blogTags';
import { getBlogTagContent } from '../../data/blog-tag-content';
import { projectEnglishRoutes } from '../../lib/blogRoutes';

const routes = projectEnglishRoutes(
  await getCollection('blog', ({ data }) => !data.draft),
).sort((a, b) => b.post.data.date.valueOf() - a.post.data.date.valueOf());

const rankedTags = getRankedBlogTagEntries(
  routes.map(route => route.post.data.tags),
);
const tagNavContent = getBlogTagContent('en', '', 0);
const siteUrl = Astro.site ?? Astro.url.origin;
const canonical = new URL('/blog/', siteUrl).toString();
const alternateUrls = [
  { lang: 'en', url: canonical },
  { lang: 'ko', url: new URL('/ko/blog/', siteUrl).toString() },
  { lang: 'x-default', url: canonical },
];
---

<MainLayout
  title="Blog | Restato"
  description="Development logs, learnings, and thoughts."
  canonical={canonical}
  alternateUrls={alternateUrls}
  lang="en"
>
  <PageShell size="content">
    <header class="fc-page-header max-w-2xl">
      <p class="fc-eyebrow">Restato journal</p>
      <h1>Blog</h1>
      <p class="fc-page-description">
        Development logs, learnings, thoughts, and coding adventures.
      </p>
    </header>

    {rankedTags.length > 0 && (
      <BlogTagNav
        entries={rankedTags}
        label="Blog tags"
        showMoreLabel="Show more"
        showLessLabel="Show less"
        formatCountLabel={tagNavContent.formatTagCount}
      />
    )}

    {routes.length > 0 ? (
      <div class="grid gap-5 md:grid-cols-2">
        {routes.map(({ post, pathname }) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            slug={post.slug}
            href={pathname}
            tags={post.data.tags}
            image={post.data.image}
          />
        ))}
      </div>
    ) : (
      <div class="fc-empty-state">
        <h2>No posts yet</h2>
        <p>The first post will be up soon!</p>
      </div>
    )}

    {routes.length > 0 && (
      <p class="mt-8 border-t border-[var(--border-subtle)] pt-5 text-sm text-[var(--text-muted)]">
        {routes.length} posts
      </p>
    )}
  </PageShell>
</MainLayout>
