---
import MainLayout from '../../layouts/MainLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import PageShell from '../../components/ui/PageShell.astro';
import { getCollection } from 'astro:content';
import { getBlogTagEntries } from '../../lib/blogTags';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const allTags = getBlogTagEntries(posts.flatMap(post => post.data.tags));
---

<MainLayout title="Blog | Restato" description="Development logs, learnings, and thoughts." lang="en">
  <PageShell size="content">
    <header class="fc-page-header">
      <p class="fc-eyebrow">Restato journal</p>
      <h1>Blog</h1>
      <p class="fc-page-description">
        Development logs, learnings, thoughts, and coding adventures.
      </p>
    </header>

    {allTags.length > 0 && (
      <nav class="mb-10 border-b border-[var(--border-subtle)] pb-6" aria-label="Blog tags">
        <div class="flex flex-wrap items-center gap-2">
          <span class="mr-1 text-sm font-bold text-[var(--text-muted)]">Tags</span>
          {allTags.map(tag => (
            <a
              href={`/blog/tag/${tag.slug}`}
              class="fc-chip border border-transparent transition-colors hover:border-[var(--brand)] hover:text-[var(--brand)]"
            >
              {tag.label}
            </a>
          ))}
        </div>
      </nav>
    )}

    {posts.length > 0 ? (
      <div class="grid gap-6 md:grid-cols-2">
        {posts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            slug={post.slug}
            tags={post.data.tags}
            image={post.data.image}
          />
        ))}
      </div>
    ) : (
      <div class="fc-empty-state">
        <h2>No posts yet</h2>
        <p>The first post will be up soon!</p>
      </div>
    )}

    {posts.length > 0 && (
      <p class="mt-8 text-center text-sm text-[var(--text-muted)]">
        {posts.length} posts
      </p>
    )}
  </PageShell>
</MainLayout>
