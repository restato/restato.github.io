---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BlogArticle from '../../components/BlogArticle.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import { selectArticleLanguage } from '../../i18n/article-language';
import { toBlogTagSlug } from '../../lib/blogTags';
import {
  getBlogAlternates,
  type BlogTranslationPair,
} from '../../lib/blogTranslations';
import { projectEnglishRoutes } from '../../lib/blogRoutes';

type BlogPost = CollectionEntry<'blog'>;

interface Props {
  post: BlogPost;
  pair?: BlogTranslationPair<BlogPost>;
  pathname: string;
}

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return projectEnglishRoutes(posts).map(route => ({
    params: { slug: route.pathname.slice('/blog/'.length, -1) },
    props: route,
  }));
}

const { post, pair, pathname } = Astro.props as Props;
const siteUrl = Astro.site ?? Astro.url.origin;
const legacyPair: BlogTranslationPair = {
  translationKey: post.slug,
  slug: post.slug,
};
const alternateUrls = getBlogAlternates(post.data.translationKey && pair ? pair : legacyPair, siteUrl);
const canonical = new URL(pathname, siteUrl).toString();
const articleLanguage = pair ? 'en' : selectArticleLanguage(post.data);
const tagUrlBuilder = (tag: string) => `/blog/tag/${toBlogTagSlug(tag)}`;
const navigationLabels = {
  home: 'Home',
  blog: 'Blog',
  backToList: 'Back to list',
  share: 'Share',
  copyLink: 'Copy link',
  copied: 'Link copied!',
};
---

<MainLayout
  title={`${post.data.title} | Restato`}
  description={post.data.description}
  image={post.data.image}
  type="article"
  publishedTime={post.data.date}
  modifiedTime={post.data.updated}
  canonical={canonical}
  alternateUrls={alternateUrls}
  lang={articleLanguage}
  lockLanguage={true}
  robots={post.data.draft ? 'noindex, nofollow' : 'index, follow'}
>
  <BlogArticle
    post={post}
    lang={articleLanguage === 'ko' ? 'ko' : 'en'}
    indexUrl="/blog"
    tagUrlBuilder={tagUrlBuilder}
    labels={navigationLabels}
  />
</MainLayout>
