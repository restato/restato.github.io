---
import MainLayout from '../../../layouts/MainLayout.astro';
import BlogCard from '../../../components/BlogCard.astro';
import PageShell from '../../../components/ui/PageShell.astro';
import { getCollection } from 'astro:content';
import { getBlogTagContent, selectBlogTagLanguage } from '../../../data/blog-tag-content';
import { getBlogTagEntries, getBlogTagRouteEntries, toBlogTagSlug } from '../../../lib/blogTags';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  const tagRoutes = getBlogTagRouteEntries(posts.flatMap(post => post.data.tags));
  const canonicalRoutes = tagRoutes.filter(route => route.kind === 'canonical');

  return canonicalRoutes.map(route => ({
    params: { tag: route.filesystemSegment },
    props: {
      tag: route.label,
      posts: posts
        .filter(post => post.data.tags.some(postTag => toBlogTagSlug(postTag) === route.canonicalSlug))
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
      legacyTagPaths: tagRoutes
        .filter(candidate => candidate.kind === 'redirect' && candidate.canonicalSlug === route.canonicalSlug)
        .map(candidate => ({
          filesystemSegment: candidate.filesystemSegment,
          urlSegment: candidate.urlSegment,
        })),
    },
  }));
}

const { tag, posts, legacyTagPaths = [] } = Astro.props;
const legacyTagPathsJson = JSON.stringify(legacyTagPaths).replace(/</g, '\\u003c');
const tagLanguage = selectBlogTagLanguage(tag, posts);
const tagContent = getBlogTagContent(tagLanguage, tag, posts.length);

// Get all unique tags for the filter section
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const allTagEntries = getBlogTagEntries(allPosts.flatMap(post => post.data.tags));
---

<MainLayout
  title={`${tag} | Blog | Restato`}
  description={tagContent.metaDescription}
  lang={tagLanguage}
  lockLanguage={true}
>
  <script
    slot="head"
    id="blog-tag-legacy-aliases"
    type="application/json"
    data-canonical-slug={toBlogTagSlug(tag)}
    set:html={legacyTagPathsJson}
  />
  <PageShell size="content">
      <header class="fc-page-header">
        <a href="/blog" class="fc-button fc-button-quiet w-fit px-2 text-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
          Blog
        </a>
        <h1>
          <span class="text-[var(--accent)]">#</span>{tag}
        </h1>
        <p class="fc-page-description">
          {tagContent.summary}
        </p>
      </header>

      <section
        class="fc-surface fc-surface-soft mb-10 p-5 sm:p-6"
        aria-labelledby="tag-introduction-title"
      >
        <h2 id="tag-introduction-title" class="mb-3 text-xl">
          {tagContent.introductionTitle}
        </h2>
        <p class="m-0 leading-7 text-[var(--text-muted)]">
          {tagContent.introduction}
        </p>
      </section>

      {allTagEntries.length > 0 && (
        <nav
          class="mb-10 border-b border-[var(--border-subtle)] pb-6"
          aria-label={tagContent.tagsLabel}
        >
          <div class="flex flex-wrap gap-2 items-center">
            <span class="mr-1 text-sm font-bold text-[var(--text-muted)]">{tagContent.tagsLabel}</span>
            <a
              href="/blog"
              class="fc-chip border border-transparent transition-colors hover:border-[var(--brand)] hover:text-[var(--brand)]"
            >
              {tagContent.allLabel}
            </a>
            {allTagEntries.map(entry => (
              <a
                href={`/blog/tag/${entry.slug}`}
                class:list={[
                  "fc-chip border transition-colors",
                  entry.label === tag
                    ? "border-[var(--brand)] bg-[var(--brand)] text-white"
                    : "border-transparent hover:border-[var(--brand)] hover:text-[var(--brand)]"
                ]}
              >
                {entry.label}
              </a>
            ))}
          </div>
        </nav>
      )}

      {posts.length > 0 ? (
        <div class="grid gap-6 md:grid-cols-2">
          {posts.map((post) => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              slug={post.slug}
              tags={post.data.tags}
              image={post.data.image}
            />
          ))}
        </div>
      ) : (
        <div class="fc-empty-state">
          <h2>{tagContent.noPostsTitle}</h2>
          <p>{tagContent.noPostsDescription}</p>
        </div>
      )}

      {posts.length > 0 && (
        <p class="mt-8 text-center text-sm text-[var(--text-muted)]">
          {tagContent.summary}
        </p>
      )}
  </PageShell>
</MainLayout>
