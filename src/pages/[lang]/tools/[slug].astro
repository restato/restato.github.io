---
import MainLayout from '../../../layouts/MainLayout.astro';
import RelatedTools from '../../../components/tools/RelatedTools.astro';
import ShareButton from '../../../components/tools/ShareButton';
import FavoriteButton from '../../../components/tools/FavoriteButton';
import BookmarkPrompt from '../../../components/tools/BookmarkPrompt';
import LocalizedToolIsland from '../../../components/tools/LocalizedToolIsland';
import AdditionalToolIsland from '../../../components/tools/AdditionalToolIsland';
import { isAdditionalToolSlug } from '../../../components/tools/additionalToolSlugs';
import AdSlot from '../../../components/ads/AdSlot.astro';
import { getPublishedTools, type ToolDefinition } from '../../../data/tools';
import { getLocalizedToolPageMetadata } from '../../../data/tools/pageMetadata';
import { supportedLanguages } from '../../../data/tools/locales';
import type { Language } from '../../../data/tools/types';
import { getToolFallbackNotice } from '../../../i18n/landing';
import { interactiveFallbackNotice as interactiveNotices, sharedToolUi } from '../../../i18n/tool-ui';

export function getStaticPaths() {
  const paths: { params: { lang: Language; slug: string }; props: { tool: ToolDefinition; lang: Language } }[] = [];

  for (const lang of supportedLanguages) {
    for (const tool of getPublishedTools().filter(tool => tool.slug !== 'anonymous-chat')) {
      paths.push({
        params: { lang, slug: tool.slug },
        props: { tool, lang }
      });
    }
  }

  return paths;
}

const { tool, lang } = Astro.props;
const { content, robots, alternateUrls } = getLocalizedToolPageMetadata(tool, lang);
const seo = content;
const fallbackNotice = getToolFallbackNotice(tool, lang);
const helpUi = sharedToolUi[lang];
const interactiveFallbackNotice = !['ko', 'en', 'ja'].includes(lang)
  ? interactiveNotices[lang]
  : null;

const pageTitle = `${seo.title} | Restato`;
const canonicalUrl = `https://restato.github.io/${lang}/tools/${tool.slug}`;

const shortTitle = seo.name;

// WebApplication Schema
const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": seo.name,
  "description": seo.description,
  "url": canonicalUrl,
  "applicationCategory": "UtilityApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "author": {
    "@type": "Person",
    "name": "Restato"
  },
  "inLanguage": lang
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": helpUi.home,
      "item": `https://restato.github.io/${lang}/tools`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": helpUi.tools,
      "item": `https://restato.github.io/${lang}/tools`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": seo.name,
      "item": canonicalUrl
    }
  ]
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: content.faq.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<MainLayout
  title={pageTitle}
  description={seo.description}
  lang={lang}
  robots={robots}
  alternateUrls={alternateUrls}
>
  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="fc-page fc-tool-shell">
    {fallbackNotice && <p class="mb-6 rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900 dark:border-amber-700 dark:bg-amber-950/30 dark:text-amber-200">{fallbackNotice}</p>}
    {interactiveFallbackNotice && <p class="mb-6 rounded-lg border border-blue-300 bg-blue-50 p-4 text-sm text-blue-900 dark:border-blue-700 dark:bg-blue-950/30 dark:text-blue-200">{interactiveFallbackNotice}</p>}
    <!-- Breadcrumb -->
    <nav class="fc-tool-breadcrumb" aria-label={helpUi.tools}>
      <ol>
        <li><a href={`/${lang}/tools`}>{helpUi.home}</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={`/${lang}/tools`}>{helpUi.tools}</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page">{shortTitle}</li>
      </ol>
    </nav>

    <!-- Header -->
    <header class="fc-tool-header">
      <div class="fc-tool-heading">
        <p class="fc-eyebrow">{helpUi.tools}</p>
        <h1><span aria-hidden="true">{tool.icon}</span> {shortTitle}</h1>
        <p>{seo.description}</p>
      </div>
      <div class="fc-tool-header-actions">
        <FavoriteButton client:load lang={lang} slug={tool.slug} title={shortTitle} icon={tool.icon} />
        <ShareButton client:load lang={lang} title={pageTitle} description={seo.description} />
      </div>
    </header>

    <!-- Tool Content -->
    <section class="fc-tool-workspace fc-surface fc-surface-padding-md" aria-label={shortTitle}>
      <p class="fc-tool-privacy">
        <span aria-hidden="true">🔒</span>
        {content.privacy}
      </p>
      {isAdditionalToolSlug(tool.slug)
        ? <AdditionalToolIsland client:load slug={tool.slug} lang={lang} />
        : <LocalizedToolIsland client:load slug={tool.slug} lang={lang} />}
    </section>

    <section class="fc-tool-instructions fc-prose">
      <div>
        <h2>{helpUi.usageGuide}</h2>
        <p>{content.overview}</p>
        <ol>
          {content.steps.map(step => <li>{step}</li>)}
        </ol>
      </div>
      <div>
        <h2>{helpUi.output}</h2>
        <ul>{content.examples.map(example => <li>{example}</li>)}</ul>
      </div>
      <div>
        <h2>{helpUi.limitations}</h2>
        <ul>{content.limitations.map(limitation => <li>{limitation}</li>)}</ul>
      </div>
      <div>
        <h2>{helpUi.privacy}</h2>
        <p>{content.privacy}</p>
      </div>
      <div>
        <h2>{helpUi.faq}</h2>
        <div class="fc-tool-faq">{content.faq.map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div>
      </div>
    </section>

    <AdSlot placement="tool-after-help" class="mt-8" />

    <!-- Related Tools -->
    <RelatedTools currentSlug={tool.slug} currentCategory={tool.category} lang={lang} />

  </div>

  <!-- Bookmark Prompt -->
  <BookmarkPrompt client:idle />

  <!-- Track tool visit -->
  <script define:vars={{ slug: tool.slug, title: shortTitle, icon: tool.icon }}>
    const STORAGE_KEY = 'restato_recent_tools';
    const MAX_RECENT = 5;

    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      let tools = stored ? JSON.parse(stored) : [];
      tools = tools.filter(t => t.slug !== slug);
      tools.unshift({ slug, title, icon, visitedAt: Date.now() });
      tools = tools.slice(0, MAX_RECENT);
      localStorage.setItem(STORAGE_KEY, JSON.stringify(tools));
    } catch (err) {
      console.error('Failed to track tool visit:', err);
    }
  </script>
</MainLayout>
