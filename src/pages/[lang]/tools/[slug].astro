---
import MainLayout from '../../../layouts/MainLayout.astro';
import RelatedTools from '../../../components/tools/RelatedTools.astro';
import ShareButton from '../../../components/tools/ShareButton';
import FavoriteButton from '../../../components/tools/FavoriteButton';
import BookmarkPrompt from '../../../components/tools/BookmarkPrompt';
import LocalizedToolIsland from '../../../components/tools/LocalizedToolIsland';
import AdSlot from '../../../components/ads/AdSlot.astro';
import { getPublishedTools, type ToolDefinition } from '../../../data/tools';
import { getLocalizedToolPageMetadata } from '../../../data/tools/pageMetadata';
import { supportedLanguages } from '../../../data/tools/locales';
import type { Language } from '../../../data/tools/types';
import { getToolFallbackNotice } from '../../../i18n/landing';
import { interactiveFallbackNotice as interactiveNotices, sharedToolUi } from '../../../i18n/tool-ui';

export function getStaticPaths() {
  const paths: { params: { lang: Language; slug: string }; props: { tool: ToolDefinition; lang: Language } }[] = [];

  for (const lang of supportedLanguages) {
    for (const tool of getPublishedTools().filter(tool => tool.slug !== 'anonymous-chat')) {
      paths.push({
        params: { lang, slug: tool.slug },
        props: { tool, lang }
      });
    }
  }

  return paths;
}

const { tool, lang } = Astro.props;
const { content, robots, alternateUrls } = getLocalizedToolPageMetadata(tool, lang);
const seo = content;
const fallbackNotice = getToolFallbackNotice(tool, lang);
const helpUi = sharedToolUi[lang];
const interactiveFallbackNotice = !['ko', 'en', 'ja'].includes(lang)
  ? interactiveNotices[lang]
  : null;

const pageTitle = `${seo.title} | Restato`;
const canonicalUrl = `https://restato.github.io/${lang}/tools/${tool.slug}`;

const shortTitle = seo.name;

// WebApplication Schema
const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": seo.name,
  "description": seo.description,
  "url": canonicalUrl,
  "applicationCategory": "UtilityApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "author": {
    "@type": "Person",
    "name": "Restato"
  },
  "inLanguage": lang
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": helpUi.home,
      "item": `https://restato.github.io/${lang}/tools`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": helpUi.tools,
      "item": `https://restato.github.io/${lang}/tools`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": seo.name,
      "item": canonicalUrl
    }
  ]
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: content.faq.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<MainLayout
  title={pageTitle}
  description={seo.description}
  lang={lang}
  robots={robots}
  alternateUrls={alternateUrls}
>
  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-4xl mx-auto px-4 py-8">
    {fallbackNotice && <p class="mb-6 rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900 dark:border-amber-700 dark:bg-amber-950/30 dark:text-amber-200">{fallbackNotice}</p>}
    {interactiveFallbackNotice && <p class="mb-6 rounded-lg border border-blue-300 bg-blue-50 p-4 text-sm text-blue-900 dark:border-blue-700 dark:bg-blue-950/30 dark:text-blue-200">{interactiveFallbackNotice}</p>}
    <!-- Breadcrumb -->
    <nav class="text-sm mb-6">
      <ol class="flex items-center gap-2">
        <li><a href={`/${lang}/tools`} class="text-[var(--color-text-muted)] hover:text-primary-500">{helpUi.home}</a></li>
        <li class="text-[var(--color-text-muted)]">/</li>
        <li><a href={`/${lang}/tools`} class="text-[var(--color-text-muted)] hover:text-primary-500">{helpUi.tools}</a></li>
        <li class="text-[var(--color-text-muted)]">/</li>
        <li class="text-[var(--color-text)]">{shortTitle}</li>
      </ol>
    </nav>

    <!-- Header -->
    <header class="mb-8">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold text-[var(--color-text)] mb-2">
            {tool.icon} {shortTitle}
          </h1>
          <p class="text-[var(--color-text-muted)]">
            {seo.description}
          </p>
        </div>
        <div class="flex items-center gap-2">
          <FavoriteButton client:load lang={lang} slug={tool.slug} title={shortTitle} icon={tool.icon} />
          <ShareButton client:load lang={lang} title={pageTitle} description={seo.description} />
        </div>
      </div>
    </header>

    <!-- Tool Content -->
    <div class="p-6 rounded-xl bg-[var(--color-card)] border border-[var(--color-border)]">
      <LocalizedToolIsland client:load slug={tool.slug} lang={lang} />
    </div>

    <section class="mt-8 space-y-8 rounded-xl border border-[var(--color-border)] bg-[var(--color-card)] p-6">
      <div>
        <h2 class="mb-3 text-xl font-semibold text-[var(--color-text)]">{helpUi.usageGuide}</h2>
        <p class="text-[var(--color-text-muted)]">{content.overview}</p>
        <ol class="mt-4 list-decimal space-y-2 pl-5 text-[var(--color-text-muted)]">
          {content.steps.map(step => <li>{step}</li>)}
        </ol>
      </div>
      <div>
        <h2 class="mb-3 text-xl font-semibold text-[var(--color-text)]">{helpUi.output}</h2>
        <ul class="list-disc space-y-2 pl-5 text-[var(--color-text-muted)]">{content.examples.map(example => <li>{example}</li>)}</ul>
      </div>
      <div>
        <h2 class="mb-3 text-xl font-semibold text-[var(--color-text)]">{helpUi.limitations}</h2>
        <ul class="list-disc space-y-2 pl-5 text-[var(--color-text-muted)]">{content.limitations.map(limitation => <li>{limitation}</li>)}</ul>
      </div>
      <div>
        <h2 class="mb-3 text-xl font-semibold text-[var(--color-text)]">{helpUi.privacy}</h2>
        <p class="text-[var(--color-text-muted)]">{content.privacy}</p>
      </div>
      <div>
        <h2 class="mb-3 text-xl font-semibold text-[var(--color-text)]">{helpUi.faq}</h2>
        <div class="space-y-4">{content.faq.map(item => <details><summary class="cursor-pointer font-medium text-[var(--color-text)]">{item.question}</summary><p class="mt-2 text-[var(--color-text-muted)]">{item.answer}</p></details>)}</div>
      </div>
    </section>

    <AdSlot placement="tool-after-help" class="mt-8" />

    <!-- Related Tools -->
    <RelatedTools currentSlug={tool.slug} currentCategory={tool.category} lang={lang} />

  </div>

  <!-- Bookmark Prompt -->
  <BookmarkPrompt client:idle />

  <!-- Track tool visit -->
  <script define:vars={{ slug: tool.slug, title: shortTitle, icon: tool.icon }}>
    const STORAGE_KEY = 'restato_recent_tools';
    const MAX_RECENT = 5;

    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      let tools = stored ? JSON.parse(stored) : [];
      tools = tools.filter(t => t.slug !== slug);
      tools.unshift({ slug, title, icon, visitedAt: Date.now() });
      tools = tools.slice(0, MAX_RECENT);
      localStorage.setItem(STORAGE_KEY, JSON.stringify(tools));
    } catch (err) {
      console.error('Failed to track tool visit:', err);
    }
  </script>
</MainLayout>
