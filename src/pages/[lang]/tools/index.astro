---
import MainLayout from '../../../layouts/MainLayout.astro';
import ToolSearch from '../../../components/tools/ToolSearch';
import RecentTools from '../../../components/tools/RecentTools';
import ToolsGrid from '../../../components/tools/ToolsGrid';
import ToolsPageHeader from '../../../components/tools/ToolsPageHeader';
import ToolsPageInfo from '../../../components/tools/ToolsPageInfo';
import { categories, getPublishedTools, type ToolDefinition } from '../../../data/tools';
import { existingToolLanguages, supportedLanguages } from '../../../data/tools/locales';
import type { Language } from '../../../data/tools/types';
import { landingContent } from '../../../i18n/landing';
import { getAlternateUrls } from '../../../i18n/urlUtils';

export function getStaticPaths() {
  return supportedLanguages.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Language };

// SEO content per language
const seoContent = {
  ko: {
    title: '무료 온라인 도구 모음 | Restato',
    description: '무료 온라인 도구 모음 - QR 코드 생성기, 비밀번호 생성기, 색상 변환기, JSON 포매터, 이미지 변환기 등 40개 이상의 무료 웹 도구. 무설치, 회원가입 불필요.',
  },
  en: {
    title: 'Free Online Tools Collection | Restato',
    description: 'Free online tools collection - QR code generator, password generator, color converter, JSON formatter, image converter and 40+ free web tools. No installation, no signup required.',
  },
  ja: {
    title: '無料オンラインツール集 | Restato',
    description: '無料オンラインツール集 - QRコード生成器、パスワード生成器、カラー変換器、JSONフォーマッター、画像変換器など40以上の無料ウェブツール。インストール不要、会員登録不要。',
  },
};

// Generate alternate URLs for hreflang
const alternateUrls = getAlternateUrls(`/${lang}/tools/`, 'https://restato.github.io');

const getToolText = (tool: ToolDefinition, language: Language, field: 'name' | 'description') => {
  return tool.content[language]?.[field] || tool.content.en?.[field] || tool.content.ko?.[field] || tool.slug;
};

// Transform registry entries to the format expected by ToolsGrid.
const tools = getPublishedTools().map(tool => ({
  slug: tool.slug === 'anonymous-chat' ? `/${lang}/anonymous-chat` : tool.slug,
  title: {
    ko: getToolText(tool, 'ko', 'name'),
    en: getToolText(tool, 'en', 'name'),
    ja: getToolText(tool, 'ja', 'name'),
  },
  description: {
    ko: getToolText(tool, 'ko', 'description'),
    en: getToolText(tool, 'en', 'description'),
    ja: getToolText(tool, 'ja', 'description'),
  },
  icon: tool.icon,
  category: tool.category,
}));

const seo = seoContent[lang as keyof typeof seoContent] ?? landingContent[lang];
const usesFallback = !existingToolLanguages.includes(lang as (typeof existingToolLanguages)[number]);
---

<MainLayout
  title={seo.title}
  description={seo.description}
  lang={lang}
  robots={usesFallback ? 'noindex, follow' : 'index, follow'}
  alternateUrls={alternateUrls}
>
  <div class="max-w-6xl mx-auto px-4 py-8">
    {usesFallback && <p class="mb-6 rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900 dark:border-amber-700 dark:bg-amber-950/30 dark:text-amber-200">{landingContent[lang].fallbackNotice}</p>}
    <!-- Header with i18n support -->
    <ToolsPageHeader client:load />

    <!-- Search -->
    <div class="mb-6">
      <ToolSearch client:load />
    </div>

    <!-- Recent Tools -->
    <RecentTools client:load className="mb-8" />

    <!-- Tools Grid with i18n support -->
    <ToolsGrid client:load lang={lang} tools={tools} categories={categories} />

    <!-- Info with i18n support -->
    <ToolsPageInfo client:load />
  </div>
</MainLayout>
