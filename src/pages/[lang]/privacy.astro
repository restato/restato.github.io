---
import SitePolicyPage from '../../components/SitePolicyPage.astro';
import { supportedLanguages } from '../../data/tools/locales';
import type { Language } from '../../data/tools/types';
export function getStaticPaths() { return supportedLanguages.map(lang => ({ params: { lang } })); }
const { lang } = Astro.params as { lang: Language };
---
<SitePolicyPage lang={lang} page="privacy" />
