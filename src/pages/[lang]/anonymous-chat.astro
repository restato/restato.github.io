---
import MainLayout from '../../layouts/MainLayout.astro';
import Chat from '../../components/Chat.tsx';
import { getTool, type Language } from '../../data/tools';
import { getLocalizedToolPageMetadata } from '../../data/tools/pageMetadata';

export function getStaticPaths() {
  return [
    { params: { lang: 'ko' } },
    { params: { lang: 'en' } },
    { params: { lang: 'ja' } }
  ];
}

const { lang } = Astro.params as { lang: Language };
const tool = getTool('anonymous-chat');
if (!tool) {
  throw new Error('Anonymous chat is missing from the tool registry');
}
const { content: seo, robots, alternateUrls } = getLocalizedToolPageMetadata(tool, lang);
const privacy = seo.privacy;

const pageTitle = `${seo.title} | Restato`;
---

<MainLayout
  title={pageTitle}
  description={seo.description}
  lang={lang}
  robots={robots}
  alternateUrls={alternateUrls}
>
  <div class="chat-page px-4 py-2">
    <p class="chat-privacy">{privacy}</p>
    <div class="chat-container">
      <Chat client:load />
    </div>
  </div>
</MainLayout>

<style>
  .chat-page {
    height: calc(100vh - 140px);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .chat-privacy {
    max-width: 48rem;
    margin: 0 auto;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .chat-container {
    min-height: 0;
    flex: 1;
  }

  @media (max-width: 768px) {
    .chat-page {
      height: calc(100vh - 120px);
    }
  }
</style>
