---
import MainLayout from '../../layouts/MainLayout.astro';
import LocalizedChatIsland from '../../components/LocalizedChatIsland';
import { getTool } from '../../data/tools';
import { getLocalizedToolPageMetadata } from '../../data/tools/pageMetadata';
import { supportedLanguages } from '../../data/tools/locales';
import type { Language } from '../../data/tools/types';
import { getToolFallbackNotice } from '../../i18n/landing';
import { interactiveFallbackNotice as interactiveNotices, sharedToolUi } from '../../i18n/tool-ui';

export function getStaticPaths() {
  return supportedLanguages.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Language };
const tool = getTool('anonymous-chat');
if (!tool) {
  throw new Error('Anonymous chat is missing from the tool registry');
}
const { content: seo, robots, alternateUrls } = getLocalizedToolPageMetadata(tool, lang);
const privacy = seo.privacy;
const fallbackNotice = getToolFallbackNotice(tool, lang);
const helpUi = sharedToolUi[lang];
const interactiveFallbackNotice = !['ko', 'en', 'ja'].includes(lang) ? interactiveNotices[lang] : null;

const pageTitle = `${seo.title} | Restato`;
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: seo.faq.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<MainLayout
  title={pageTitle}
  description={seo.description}
  lang={lang}
  robots={robots}
  alternateUrls={alternateUrls}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="fc-page fc-tool-shell">
    {fallbackNotice && <p class="fc-surface-soft fc-surface-padding-sm">{fallbackNotice}</p>}
    {interactiveFallbackNotice && <p class="fc-surface-soft fc-surface-padding-sm">{interactiveFallbackNotice}</p>}
    <header class="fc-tool-header">
      <div class="fc-tool-heading">
        <p class="fc-eyebrow">{helpUi.tools}</p>
        <h1><span aria-hidden="true">{tool.icon}</span> {seo.name}</h1>
        <p>{seo.description}</p>
      </div>
    </header>
    <section class="fc-tool-workspace fc-surface fc-surface-padding-md" aria-label={seo.name}>
      <p class="fc-tool-privacy"><span aria-hidden="true">🔒</span>{privacy}</p>
      <div class="chat-container">
        <LocalizedChatIsland client:load lang={lang} />
      </div>
    </section>
    <section class="fc-tool-instructions fc-prose">
      <div>
        <h2>{helpUi.usageGuide}</h2>
        <p>{seo.overview}</p>
        <ol>{seo.steps.map(step => <li>{step}</li>)}</ol>
      </div>
      <div><h2>{helpUi.output}</h2><ul>{seo.examples.map(example => <li>{example}</li>)}</ul></div>
      <div><h2>{helpUi.limitations}</h2><ul>{seo.limitations.map(limitation => <li>{limitation}</li>)}</ul></div>
      <div><h2>{helpUi.privacy}</h2><p>{privacy}</p></div>
      <div><h2>{helpUi.faq}</h2><div class="fc-tool-faq">{seo.faq.map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div></div>
    </section>
  </div>
</MainLayout>

<style>
  .chat-container {
    min-height: 32rem;
    height: calc(100vh - 180px);
  }

  @media (max-width: 768px) {
    .chat-container {
      height: calc(100vh - 220px);
    }
  }
</style>
