---
import MainLayout from '../layouts/MainLayout.astro';
import ExchangeRatesPanel from '../components/dashboard/ExchangeRatesPanel';
import PageShell from '../components/ui/PageShell.astro';
---

<MainLayout
  title="대시보드 | Restato"
  description="매일 보는 환율 지표를 한 화면에서 확인하는 개인 대시보드"
  lang="ko"
  robots="noindex, follow"
>
  <PageShell size="wide">
    <header class="fc-page-header">
      <p class="fc-eyebrow">개인 대시보드</p>
      <h1>매일 보는 지표</h1>
      <p class="fc-page-description">
        내가 자주 확인하는 환율을 빠르게 보기 위한 한글 전용 페이지입니다.
      </p>
    </header>

    <div class="fc-surface fc-surface-padding-md">
      <ExchangeRatesPanel client:load />
    </div>
  </PageShell>
</MainLayout>
