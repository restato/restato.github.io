---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BlogArticle from '../../../components/BlogArticle.astro';
import MainLayout from '../../../layouts/MainLayout.astro';
import { toBlogTagSlug } from '../../../lib/blogTags';
import {
  getBlogAlternates,
  type BlogTranslationPair,
} from '../../../lib/blogTranslations';
import { projectKoreanRoutes } from '../../../lib/blogRoutes';

type BlogPost = CollectionEntry<'blog'>;

interface Props {
  post: BlogPost;
  pair: BlogTranslationPair<BlogPost>;
  pathname: string;
}

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return projectKoreanRoutes(posts).map(route => ({
    params: { slug: route.pathname.slice('/ko/blog/'.length, -1) },
    props: route,
  }));
}

const { post, pair, pathname } = Astro.props as Props;
const siteUrl = Astro.site ?? Astro.url.origin;
const fallbackPair: BlogTranslationPair = {
  translationKey: post.slug,
  slug: post.slug,
};
const alternateUrls = getBlogAlternates(post.data.translationKey && pair ? pair : fallbackPair, siteUrl);
const canonical = new URL(pathname, siteUrl).toString();
const tagUrlBuilder = (tag: string) => `/blog/tag/${toBlogTagSlug(tag)}`;
const navigationLabels = {
  home: '홈',
  blog: '블로그',
  backToList: '목록으로 돌아가기',
  share: '공유',
  copyLink: '링크 복사',
  copied: '링크가 복사되었습니다!',
};
---

<MainLayout
  title={`${post.data.title} | Restato`}
  description={post.data.description}
  image={post.data.image}
  type="article"
  publishedTime={post.data.date}
  modifiedTime={post.data.updated}
  canonical={canonical}
  alternateUrls={alternateUrls}
  lang="ko"
  lockLanguage={true}
  robots={post.data.draft ? 'noindex, nofollow' : 'index, follow'}
>
  <BlogArticle
    post={post}
    indexUrl="/ko/blog"
    tagUrlBuilder={tagUrlBuilder}
    labels={navigationLabels}
  />
</MainLayout>
