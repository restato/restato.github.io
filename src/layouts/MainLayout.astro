---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Language } from '../data/tools/types';
import { getSkipLinkLabel, skipLinkLabels } from '../i18n/skip-link';

interface AlternateUrl {
  lang: string;
  url: string;
}

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  robots?: string;
  canonical?: string;
  lang?: Language;
  lockLanguage?: boolean;
  alternateUrls?: AlternateUrl[];
}

const { title, description, image, type, publishedTime, modifiedTime, author, robots, canonical, lang, lockLanguage, alternateUrls } = Astro.props;
const skipLinkLabel = getSkipLinkLabel(lang ?? 'ko');
---

<BaseLayout title={title} description={description} image={image} type={type} publishedTime={publishedTime} modifiedTime={modifiedTime} author={author} robots={robots} canonical={canonical} lang={lang} lockLanguage={lockLanguage} alternateUrls={alternateUrls}>
  <slot name="head" slot="head" />
  <a
    href="#main-content"
    class="fc-button fc-button-primary fixed left-4 top-3 z-[60] -translate-y-24 transition-transform focus:translate-y-0"
    data-skip-link
    data-skip-link-labels={JSON.stringify(skipLinkLabels)}
  >
    {skipLinkLabel}
  </a>
  <Header lang={lang} lockLanguage={lockLanguage} />
  <main id="main-content" class="flex-1" tabindex="-1">
    <slot />
  </main>
  <Footer lang={lang} />
  <script>
    const skipLink = document.querySelector('[data-skip-link]');
    if (skipLink instanceof HTMLAnchorElement) {
      const labels = JSON.parse(skipLink.dataset.skipLinkLabels || '{}');
      const updateSkipLink = (language: string) => {
        skipLink.textContent = labels[language] || labels.ko;
      };

      const storedLanguage = localStorage.getItem('lang');
      updateSkipLink(storedLanguage && labels[storedLanguage]
        ? storedLanguage
        : document.documentElement.lang);
      window.addEventListener('languageChange', (event) => {
        updateSkipLink((event as CustomEvent<string>).detail);
      });
    }
  </script>
</BaseLayout>
