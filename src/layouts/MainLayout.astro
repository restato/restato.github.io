---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Language } from '../data/tools/types';
import { getSkipLinkLabel, skipLinkLabels } from '../i18n/skip-link';
import { resolveLayoutLanguageUrls } from '../i18n/urlUtils';

interface AlternateUrl {
  lang: string;
  url: string;
}

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  robots?: string;
  canonical?: string;
  lang?: Language;
  lockLanguage?: boolean;
  alternateUrls?: AlternateUrl[];
  languageUrls?: Partial<Record<Language, string>>;
}

const { title, description, image, type, publishedTime, modifiedTime, author, robots, canonical, lang, lockLanguage = false, alternateUrls, languageUrls } = Astro.props;
const resolvedLanguage = lang ?? 'ko';
const skipLinkLabel = getSkipLinkLabel(resolvedLanguage);
const resolvedLanguageUrls = resolveLayoutLanguageUrls({
  languageUrls,
  alternateUrls,
  deriveFromAlternates: lockLanguage && type === 'article',
});
---

<BaseLayout title={title} description={description} image={image} type={type} publishedTime={publishedTime} modifiedTime={modifiedTime} author={author} robots={robots} canonical={canonical} lang={lang} lockLanguage={lockLanguage} alternateUrls={alternateUrls}>
  <slot name="head" slot="head" />
  <a
    href="#main-content"
    class="fc-button fc-button-primary fixed left-4 top-3 z-[60] -translate-y-24 transition-transform focus:translate-y-0"
    data-skip-link
    data-skip-link-labels={JSON.stringify(skipLinkLabels)}
    data-page-language={resolvedLanguage}
    data-lock-language={lockLanguage ? 'true' : 'false'}
  >
    {skipLinkLabel}
  </a>
  <Header lang={lang} lockLanguage={lockLanguage} languageUrls={resolvedLanguageUrls} />
  <main id="main-content" class="flex-1" tabindex="-1">
    <slot />
  </main>
  <Footer lang={lang} />
  <script>
    const skipLink = document.querySelector('[data-skip-link]');
    if (skipLink instanceof HTMLAnchorElement) {
      const labels = JSON.parse(skipLink.dataset.skipLinkLabels || '{}');
      const lockLanguage = skipLink.dataset.lockLanguage === 'true';
      const pageLanguage = skipLink.dataset.pageLanguage || document.documentElement.lang;
      const updateSkipLink = (language: string) => {
        skipLink.textContent = labels[language] || labels.ko;
      };

      const storedLanguage = localStorage.getItem('lang');
      updateSkipLink(lockLanguage
        ? pageLanguage
        : storedLanguage && labels[storedLanguage]
          ? storedLanguage
          : document.documentElement.lang);
      window.addEventListener('languageChange', (event) => {
        if (lockLanguage) return;
        updateSkipLink((event as CustomEvent<string>).detail);
      });
    }
  </script>
</BaseLayout>
