---
import '../styles/global.css';
import { localeMetadata } from '../i18n';
import type { Language } from '../data/tools/types';
import { normalizeHeadAlternates, parseLanguage } from '../i18n/urlUtils';
import ConsentBanner from '../components/ConsentBanner.astro';

interface AlternateUrl {
  lang: string;
  url: string;
}

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  robots?: string;
  canonical?: string;
  lang?: Language;
  lockLanguage?: boolean;
  alternateUrls?: AlternateUrl[];
}

const {
  title,
  description = '개발 일지 - 배우고 만들고 기록하는 공간',
  image = '/images/og-default.png',
  type = 'website',
  publishedTime,
  modifiedTime,
  author = 'Restato',
  robots = 'index, follow',
  canonical,
  lang = 'ko',
  lockLanguage = false,
  alternateUrls = []
} = Astro.props;

const ogLocale = localeMetadata[lang].og;

const normalizedAlternateUrls = normalizeHeadAlternates(alternateUrls);
const clientLocaleMap = Object.fromEntries(
  Object.entries(localeMetadata).map(([code, metadata]) => [code, { html: metadata.html, ogLocale: metadata.og }]),
);
const metadataLanguageLocked = lockLanguage || parseLanguage(Astro.url.pathname) !== null;

const canonicalURL = canonical
  ? new URL(canonical, Astro.site)
  : new URL(Astro.url.pathname, Astro.site);
const siteName = 'Restato';
const twitterHandle = '@restato_dev';
const gaId = import.meta.env.PUBLIC_GA_ID?.trim() ?? '';

// JSON-LD Schema
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": siteName,
  "description": description,
  "url": Astro.site?.toString(),
  "author": {
    "@type": "Person",
    "name": author
  },
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${Astro.site}blog?q={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
};

const articleSchema = type === 'article' ? {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "image": new URL(image, Astro.site).toString(),
  "url": canonicalURL.toString(),
  "datePublished": publishedTime?.toISOString(),
  "dateModified": modifiedTime?.toISOString() || publishedTime?.toISOString(),
  "author": {
    "@type": "Person",
    "name": author
  },
  "publisher": {
    "@type": "Organization",
    "name": siteName,
    "logo": {
      "@type": "ImageObject",
      "url": new URL('/favicon.svg', Astro.site).toString()
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL.toString()
  }
} : null;
---

<!doctype html>
<html lang={localeMetadata[lang].html} dir={localeMetadata[lang].dir} data-locale-map={JSON.stringify(clientLocaleMap)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- hreflang for multi-language -->
    {normalizedAlternateUrls.map(alt => (
      <link rel="alternate" hreflang={alt.lang} href={alt.url} />
    ))}

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale} />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {type === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}
    {type === 'article' && (
      <meta property="article:author" content={author} />
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={twitterHandle} />
    <meta name="twitter:creator" content={twitterHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <!-- Additional SEO -->
    <meta name="author" content={author} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <meta name="google-site-verification" content="0GLTtjarMTr8NsaJaP-z0tbHPycvu_rOoQykr81BL0o" />
    <meta name="google-adsense-account" content="ca-pub-5341896100319873" />
    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/rss.xml" />
    <slot name="head" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {articleSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    )}

    <!-- Theme Script -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      }
    </script>

    <!-- Language Script -->
    {!metadataLanguageLocked && (
      <script is:inline>
        (function() {
          const langMap = JSON.parse(document.documentElement.dataset.localeMap || '{}');

          function updateHtmlLang(lang) {
            const config = langMap[lang];
            if (!config) return;

            document.documentElement.lang = config.html;

            const ogLocaleMeta = document.querySelector('meta[property="og:locale"]');
            if (ogLocaleMeta) {
              ogLocaleMeta.setAttribute('content', config.ogLocale);
            }
          }

          // Initial language setup
          const stored = localStorage.getItem('lang');
          const browserLang = navigator.language.split('-')[0];
          const lang = (stored && langMap[stored]) ? stored :
                       (langMap[browserLang] ? browserLang : 'ko');
          updateHtmlLang(lang);

          // Listen for language changes
          window.addEventListener('languageChange', function(e) {
            updateHtmlLang(e.detail);
          });
        })();
      </script>
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    <slot />
    <ConsentBanner lang={lang} gaId={gaId} />
  </body>
</html>
