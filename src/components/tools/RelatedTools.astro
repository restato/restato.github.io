---
import { getTool, type Language, type ToolDefinition } from '../../data/tools';
import { relatedToolsTitle } from '../../i18n/tool-ui';
import { getLocalizedToolHref } from './toolLinks';

interface Props {
  currentSlug: string;
  currentCategory?: string;
  lang?: Language;
}

const { currentSlug, lang = 'ko' } = Astro.props;

const relatedTitle = relatedToolsTitle[lang];

const relatedTools = (getTool(currentSlug)?.related ?? [])
  .map(getTool)
  .filter((tool): tool is ToolDefinition => Boolean(tool))
  .map(tool => ({
    slug: tool.slug,
    title: tool.content[lang]?.name || tool.content.ko?.name || tool.slug,
    description: tool.content[lang]?.description || tool.content.ko?.description || '',
    icon: tool.icon,
  }));
---

<section class="mt-12 border-t border-[var(--border-subtle)] pt-8">
  <h2 class="mb-5 flex items-center gap-2 text-xl font-bold text-[var(--text-primary)]">
    <span>🔧</span> {relatedTitle}
  </h2>
  <div class="fc-surface overflow-hidden">
    <ul class="m-0 grid list-none p-0 md:grid-cols-2">
      {relatedTools.map((tool) => (
        <li class="border-b border-[var(--border-subtle)] md:border-r">
          <a
            href={getLocalizedToolHref(tool.slug, lang)}
            class="group flex min-h-20 items-center gap-3 px-4 py-3 transition-colors hover:bg-[var(--surface-soft)]"
          >
            <span class="w-10 shrink-0 text-center text-2xl" aria-hidden="true">{tool.icon}</span>
            <div class="min-w-0 flex-1">
              <h3 class="m-0 truncate font-bold text-[var(--text-primary)] group-hover:text-[var(--brand)]">
                {tool.title}
              </h3>
              <span class="mt-0.5 block truncate text-sm text-[var(--text-muted)]">
                {tool.description}
              </span>
            </div>
            <span class="shrink-0 text-[var(--text-muted)]" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
