---
import type { Language } from '../data/tools/types';
import { sharedToolUi } from '../i18n/tool-ui';
import { siteContent, siteInformationLabel, sitePageKeys } from '../data/site-content';
import BrandMark from './BrandMark.astro';

interface Props { lang?: Language }
const { lang = 'ko' } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-[var(--border-subtle)] bg-[var(--surface-raised)]">
  <div class="mx-auto grid max-w-[88rem] gap-8 px-4 py-10 sm:px-6 md:grid-cols-[minmax(14rem,1fr)_minmax(18rem,2fr)_auto] md:items-start">
    <div class="grid gap-3">
      <a href={`/${lang}/`} class="flex min-h-11 items-center gap-2 font-bold text-[var(--text-primary)]">
        <BrandMark size={32} />
        <span>Restato</span>
      </a>
      <p class="m-0 max-w-sm text-sm text-[var(--text-muted)]">
        &copy; <span data-current-year>{currentYear}</span> Restato. {sharedToolUi[lang].footer}
      </p>
    </div>

    <nav aria-label={siteInformationLabel[lang]}>
      <ul class="grid grid-cols-2 gap-x-5 gap-y-1 p-0 text-sm sm:grid-cols-3">
        {sitePageKeys.map(page => (
          <li>
            <a
              class="flex min-h-11 items-center text-[var(--text-muted)] transition-colors hover:text-[var(--text-primary)] hover:underline"
              href={`/${lang}/${page}/`}
            >
              {siteContent[page][lang].title}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <a
        href="https://www.linkedin.com/in/direcision/"
        target="_blank"
        rel="noopener noreferrer"
        class="fc-button fc-button-quiet w-11 px-0"
        aria-label="LinkedIn"
      >
        <svg aria-hidden="true" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M4.98 3.5A2.5 2.5 0 1 0 5 8.5 2.5 2.5 0 0 0 4.98 3.5zM3 9h4v12H3zm7 0h3.8v1.7h.1c.5-.9 1.8-1.9 3.7-1.9 4 0 4.7 2.5 4.7 5.8V21h-4v-5.6c0-1.3 0-3.1-1.9-3.1s-2.2 1.5-2.2 3V21h-4z"></path>
        </svg>
      </a>
      <a
        href="mailto:direcision@gmail.com"
        class="fc-button fc-button-quiet w-11 px-0"
        aria-label="Email"
      >
        <svg aria-hidden="true" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 7h18v10H3V7z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" d="m3 8 9 6 9-6"></path>
        </svg>
      </a>
      <a
        href="https://github.com/restato"
        target="_blank"
        rel="noopener noreferrer"
        class="fc-button fc-button-quiet w-11 px-0"
        aria-label="GitHub"
      >
        <svg aria-hidden="true" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
        </svg>
      </a>
    </div>
  </div>
</footer>
