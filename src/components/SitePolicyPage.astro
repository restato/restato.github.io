---
import MainLayout from '../layouts/MainLayout.astro';
import { siteContent, type SitePageKey } from '../data/site-content';
import type { Language } from '../data/tools/types';
import { getAlternateUrls } from '../i18n/urlUtils';

interface Props {
  lang: Language;
  page: SitePageKey;
}

const { lang, page } = Astro.props;
const content = siteContent[page][lang];
const siteUrl = 'https://restato.github.io';
const path = `/${lang}/${page}/`;
const alternateUrls = getAlternateUrls(path, siteUrl);
---

<MainLayout
  title={`${content.title} | Restato`}
  description={content.description}
  robots="index, follow"
  canonical={`${siteUrl}${path}`}
  lang={lang}
  alternateUrls={alternateUrls}
>
  <article class="max-w-3xl mx-auto px-6 py-12 sm:py-16">
    <header class="mb-10 border-b border-[var(--color-border)] pb-8">
      <h1 class="text-3xl sm:text-4xl font-bold text-[var(--color-text)]">{content.title}</h1>
      <p class="mt-4 text-lg leading-8 text-[var(--color-text-muted)]">{content.description}</p>
      <p class="mt-4 text-sm text-[var(--color-text-muted)]">{content.effectiveDate}</p>
    </header>

    <div class="space-y-10">
      {content.sections.map(section => (
        <section>
          <h2 class="text-xl font-semibold text-[var(--color-text)]">{section.heading}</h2>
          {section.paragraphs.map(paragraph => (
            <p class="mt-3 leading-7 text-[var(--color-text-muted)]">{paragraph}</p>
          ))}
        </section>
      ))}
    </div>
  </article>
</MainLayout>
