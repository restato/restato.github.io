---
import type { Language } from '../data/tools/types';

interface Props { lang: Language; gaId: string }
const { lang, gaId } = Astro.props;

const copy: Record<Language, { message: string; accept: string; reject: string }> = {
  ko: { message: '익명 분석 쿠키로 방문 통계를 측정합니다. 광고 목적으로는 사용하지 않습니다.', accept: '확인', reject: '분석 거부' },
  en: { message: 'We measure visits with anonymous analytics cookies. They are never used for advertising.', accept: 'Got it', reject: 'Opt out' },
  ja: { message: '匿名の分析Cookieで訪問数を測定します。広告目的には使用しません。', accept: 'OK', reject: '分析を拒否' },
  'zh-CN': { message: '我们使用匿名分析 Cookie 统计访问量，绝不用于广告目的。', accept: '知道了', reject: '拒绝分析' },
  'zh-TW': { message: '我們使用匿名分析 Cookie 統計造訪量，絕不用於廣告目的。', accept: '知道了', reject: '拒絕分析' },
  es: { message: 'Medimos las visitas con cookies analíticas anónimas. Nunca se usan con fines publicitarios.', accept: 'Entendido', reject: 'Rechazar análisis' },
  pt: { message: 'Medimos as visitas com cookies de análise anônimos. Nunca são usados para publicidade.', accept: 'Entendi', reject: 'Recusar análise' },
  de: { message: 'Wir messen Besuche mit anonymen Analyse-Cookies. Sie werden nie für Werbung genutzt.', accept: 'Verstanden', reject: 'Analyse ablehnen' },
  fr: { message: 'Nous mesurons les visites avec des cookies d’analyse anonymes. Jamais à des fins publicitaires.', accept: 'J’ai compris', reject: 'Refuser l’analyse' },
  it: { message: 'Misuriamo le visite con cookie analitici anonimi. Non vengono mai usati per la pubblicità.', accept: 'Ho capito', reject: 'Rifiuta analisi' },
  id: { message: 'Kami mengukur kunjungan dengan kuki analitik anonim. Tidak pernah digunakan untuk iklan.', accept: 'Mengerti', reject: 'Tolak analitik' },
  hi: { message: 'हम गुमनाम एनालिटिक्स कुकी से विज़िट मापते हैं। इनका उपयोग विज्ञापन के लिए कभी नहीं होता।', accept: 'समझ गया', reject: 'एनालिटिक्स अस्वीकारें' },
};
---

{gaId && (
  <aside
    data-consent-banner
    data-ga-id={gaId}
    class="fc-surface fixed inset-x-0 bottom-0 z-50 hidden rounded-none border-x-0 border-b-0 bg-[var(--surface-raised)] p-0"
    aria-label={copy[lang].message}
  >
    <div class="mx-auto flex max-w-[88rem] flex-col items-start gap-3 px-4 py-3 sm:flex-row sm:items-center sm:px-6">
      <p class="m-0 flex-1 text-sm leading-6 text-[var(--text-primary)]">{copy[lang].message}</p>
      <div class="flex shrink-0 flex-wrap gap-2">
        <button data-consent="denied" type="button" class="fc-button fc-button-secondary text-sm">
          {copy[lang].reject}
        </button>
        <button data-consent="granted" type="button" class="fc-button fc-button-primary text-sm">
          {copy[lang].accept}
        </button>
      </div>
    </div>
  </aside>
)}

<script>
  import { getAnalyticsConsent, loadGoogleAnalytics, setAnalyticsConsent } from '../lib/analytics';

  const banner = document.querySelector<HTMLElement>('[data-consent-banner]');
  if (banner) {
    const gaId = banner.dataset.gaId ?? '';
    const consent = getAnalyticsConsent();
    loadGoogleAnalytics(gaId);
    if (consent === 'unset') banner.classList.remove('hidden');

    banner.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach(button => {
      button.addEventListener('click', () => {
        const choice = button.dataset.consent;
        if (choice !== 'granted' && choice !== 'denied') return;
        setAnalyticsConsent(choice);
        banner.classList.add('hidden');
      });
    });
  }
</script>
