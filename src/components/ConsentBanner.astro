---
import type { Language } from '../data/tools/types';

interface Props { lang: Language; gaId: string }
const { lang, gaId } = Astro.props;

const copy: Record<Language, { message: string; accept: string; reject: string }> = {
  ko: { message: '쿠키 없이 익명 방문량을 측정합니다. 더 정확한 사용 분석을 위한 분석 쿠키를 허용하시겠어요?', accept: '분석 쿠키 허용', reject: '쿠키 없이 계속' },
  en: { message: 'We measure anonymous visits without cookies. Allow analytics cookies for more accurate usage insights?', accept: 'Allow analytics cookies', reject: 'Continue without cookies' },
  ja: { message: 'Cookieを使わず匿名の訪問数を測定します。より正確な利用分析のため分析Cookieを許可しますか？', accept: '分析Cookieを許可', reject: 'Cookieなしで続行' },
  'zh-CN': { message: '我们会在不使用 Cookie 的情况下统计匿名访问量。是否允许分析 Cookie 以获得更准确的使用数据？', accept: '允许分析 Cookie', reject: '无 Cookie 继续' },
  'zh-TW': { message: '我們會在不使用 Cookie 的情況下統計匿名造訪量。是否允許分析 Cookie 以取得更準確的使用資料？', accept: '允許分析 Cookie', reject: '不使用 Cookie 繼續' },
  es: { message: 'Medimos visitas anónimas sin cookies. ¿Permitir cookies analíticas para obtener datos de uso más precisos?', accept: 'Permitir cookies analíticas', reject: 'Continuar sin cookies' },
  pt: { message: 'Medimos visitas anônimas sem cookies. Permitir cookies de análise para dados de uso mais precisos?', accept: 'Permitir cookies de análise', reject: 'Continuar sem cookies' },
  de: { message: 'Wir messen anonyme Besuche ohne Cookies. Analyse-Cookies für genauere Nutzungsdaten zulassen?', accept: 'Analyse-Cookies zulassen', reject: 'Ohne Cookies fortfahren' },
  fr: { message: 'Nous mesurons les visites anonymes sans cookies. Autoriser les cookies d’analyse pour des données plus précises ?', accept: 'Autoriser les cookies d’analyse', reject: 'Continuer sans cookies' },
  it: { message: 'Misuriamo le visite anonime senza cookie. Consentire i cookie analitici per dati di utilizzo più precisi?', accept: 'Consenti cookie analitici', reject: 'Continua senza cookie' },
  id: { message: 'Kami mengukur kunjungan anonim tanpa kuki. Izinkan kuki analitik untuk data penggunaan yang lebih akurat?', accept: 'Izinkan kuki analitik', reject: 'Lanjutkan tanpa kuki' },
  hi: { message: 'हम बिना कुकी के गुमनाम विज़िट मापते हैं। अधिक सटीक उपयोग जानकारी के लिए एनालिटिक्स कुकी की अनुमति दें?', accept: 'एनालिटिक्स कुकी की अनुमति दें', reject: 'बिना कुकी जारी रखें' },
};
---

{gaId && (
  <aside
    data-consent-banner
    data-ga-id={gaId}
    class="fc-surface fixed inset-x-0 bottom-0 z-50 hidden rounded-none border-x-0 border-b-0 bg-[var(--surface-raised)] p-0"
    aria-label={copy[lang].message}
  >
    <div class="mx-auto flex max-w-[88rem] flex-col items-start gap-3 px-4 py-3 sm:flex-row sm:items-center sm:px-6">
      <p class="m-0 flex-1 text-sm leading-6 text-[var(--text-primary)]">{copy[lang].message}</p>
      <div class="flex shrink-0 flex-wrap gap-2">
        <button data-consent="denied" type="button" class="fc-button fc-button-secondary text-sm">
          {copy[lang].reject}
        </button>
        <button data-consent="granted" type="button" class="fc-button fc-button-primary text-sm">
          {copy[lang].accept}
        </button>
      </div>
    </div>
  </aside>
)}

<script>
  import { getAnalyticsConsent, loadGoogleAnalytics, setAnalyticsConsent } from '../lib/analytics';

  const banner = document.querySelector<HTMLElement>('[data-consent-banner]');
  if (banner) {
    const gaId = banner.dataset.gaId ?? '';
    const consent = getAnalyticsConsent();
    loadGoogleAnalytics(gaId);
    if (consent === 'unset') banner.classList.remove('hidden');

    banner.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach(button => {
      button.addEventListener('click', () => {
        const choice = button.dataset.consent;
        if (choice !== 'granted' && choice !== 'denied') return;
        setAnalyticsConsent(choice);
        banner.classList.add('hidden');
      });
    });
  }
</script>
