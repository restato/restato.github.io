---
interface Props {
  title: string;
  description: string;
  date: Date;
  slug: string;
  tags?: string[];
  image?: string;
}

const { title, description, date, slug, tags = [], image } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="h-full">
  <a
    href={`/blog/${slug}`}
    class="fc-surface block h-full overflow-hidden transition-colors hover:border-[var(--brand)]"
  >
    {image && (
      <div class="border-b border-[var(--border-subtle)]">
        <img
          src={image}
          alt={title}
          class="aspect-[16/9] w-full object-cover"
          loading="lazy"
        />
      </div>
    )}

    <div class="p-5 sm:p-6">
      <time
        datetime={date.toISOString()}
        class="text-sm text-[var(--text-muted)]"
      >
        {formattedDate}
      </time>

      <h3 class="mt-2 line-clamp-2 text-xl font-bold leading-snug text-[var(--text-primary)]">
        {title}
      </h3>

      <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-[var(--text-muted)]">
        {description}
      </p>

      {tags.length > 0 && (
        <ul class="m-0 mt-4 flex list-none flex-wrap gap-x-3 gap-y-1 p-0" aria-label="Article tags">
          {tags.slice(0, 3).map((tag) => (
            <li class="text-xs text-[var(--brand)]">#{tag}</li>
          ))}
        </ul>
      )}
    </div>
  </a>
</article>
