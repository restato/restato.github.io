---
interface Props {
  title: string;
  description: string;
  date: Date;
  slug: string;
  tags?: string[];
  image?: string;
}

const { title, description, date, slug, tags = [], image } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article>
  <a
    href={`/blog/${slug}`}
    class="fc-surface block h-full overflow-hidden transition-colors hover:border-[var(--brand)]"
  >
    {image && (
      <div class="border-b border-[var(--border-subtle)]">
        <img
          src={image}
          alt={title}
          class="aspect-[16/9] w-full object-cover"
          loading="lazy"
        />
      </div>
    )}

    <div class="p-5">
      <time
        datetime={date.toISOString()}
        class="text-xs font-bold uppercase tracking-wide text-[var(--accent)]"
      >
        {formattedDate}
      </time>

      <h3 class="mt-3 line-clamp-2 text-lg font-bold leading-snug text-[var(--text-primary)]">
        {title}
      </h3>

      <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-[var(--text-muted)]">
        {description}
      </p>

      {tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {tags.slice(0, 3).map((tag) => (
            <span class="fc-chip text-xs">
              {tag}
            </span>
          ))}
          {tags.length > 3 && (
            <span class="px-2 py-0.5 text-xs text-[var(--text-muted)]">
              +{tags.length - 3}
            </span>
          )}
        </div>
      )}
    </div>
  </a>
</article>
