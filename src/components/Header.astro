---
import { languages, type Language } from '../i18n';
import { getBasePathFromUrl, buildLanguageUrl, supportsLanguageRouting, supportedLanguagePattern } from '../i18n/urlUtils';
import { siteChrome } from '../i18n/tool-ui';

interface NavItem {
  href: string;
  labelKey: keyof typeof siteChrome.en.nav;
}

interface Props {
  lang?: Language;
  lockLanguage?: boolean;
}

const navItems: NavItem[] = [
  { href: '/', labelKey: 'home' },
  { href: '/blog', labelKey: 'blog' },
  { href: '/articles', labelKey: 'articles' },
  { href: '/jobs', labelKey: 'jobs' },
  { href: '/tools', labelKey: 'tools' },
  { href: '/games', labelKey: 'games' },
  { href: '/projects', labelKey: 'projects' },
];

const currentPath = Astro.url.pathname;
const { lang = 'ko', lockLanguage = false } = Astro.props;

const isActive = (href: string): boolean => {
  const normalizedCurrent = getBasePathFromUrl(currentPath);
  const normalizedHref = getBasePathFromUrl(href);
  return normalizedCurrent === normalizedHref ||
    (normalizedHref !== '/' && normalizedCurrent.startsWith(normalizedHref));
};

const getNavHref = (baseHref: string): string => {
  if (supportsLanguageRouting(baseHref)) {
    return buildLanguageUrl(baseHref, lang);
  }
  return baseHref;
};

const primaryNavigationLabels: Record<Language, string> = {
  ko: '주요 메뉴',
  en: 'Primary navigation',
  ja: 'メインナビゲーション',
  'zh-CN': '主导航',
  'zh-TW': '主要導覽',
  es: 'Navegación principal',
  pt: 'Navegação principal',
  de: 'Hauptnavigation',
  fr: 'Navigation principale',
  it: 'Navigazione principale',
  id: 'Navigasi utama',
  hi: 'मुख्य नेविगेशन',
};
const chrome = {
  ...siteChrome[lang],
  primaryNavigation: primaryNavigationLabels[lang],
};
const navTranslations = Object.fromEntries(Object.keys(siteChrome.en.nav).map(key => [key, Object.fromEntries(Object.entries(siteChrome).map(([language, copy]) => [language, copy.nav[key as keyof typeof copy.nav]]))]));
const darkModeTranslations = Object.fromEntries(Object.entries(siteChrome).map(([language, copy]) => [language, copy.darkMode]));
const selectLanguageTranslations = Object.fromEntries(Object.entries(siteChrome).map(([language, copy]) => [language, copy.selectLanguage]));
const toggleMenuTranslations = Object.fromEntries(Object.entries(siteChrome).map(([language, copy]) => [language, copy.toggleMenu]));
const primaryNavigationTranslations = Object.fromEntries(Object.entries(primaryNavigationLabels));
---

<header class="sticky top-0 z-50 border-b border-[var(--border-subtle)] bg-[var(--surface-raised)]">
  <nav
    id="primary-navigation"
    aria-label={chrome.primaryNavigation}
    class="mx-auto flex h-16 max-w-[88rem] items-center gap-3 px-4 sm:px-6"
  >
    <a href="/" class="flex min-h-11 shrink-0 items-center gap-2 font-bold text-[var(--text-primary)]">
      <span aria-hidden="true" class="h-2.5 w-2.5 rounded-full bg-[var(--brand)]"></span>
      <span>Restato</span>
    </a>

    <ul class="hidden min-w-0 flex-1 items-center justify-center gap-0.5 lg:flex">
      {navItems.map((item) => (
        <li>
          <a
            href={getNavHref(item.href)}
            data-base-href={item.href}
            data-nav-key={item.labelKey}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class={`flex min-h-11 items-center rounded-[0.625rem] px-2.5 text-sm font-medium transition-colors ${
              isActive(item.href)
                ? 'bg-[var(--surface-soft)] text-[var(--brand)]'
                : 'text-[var(--text-muted)] hover:bg-[var(--surface-soft)] hover:text-[var(--text-primary)]'
            }`}
          >
            {chrome.nav[item.labelKey]}
          </a>
        </li>
      ))}
    </ul>

    <div class="ml-auto flex shrink-0 items-center gap-1">
      {!lockLanguage && <div class="relative hidden lg:block" id="lang-selector">
        <button
          id="lang-trigger"
          type="button"
          class="fc-button fc-button-secondary px-3 text-sm"
          aria-label={chrome.selectLanguage}
          aria-controls="lang-menu"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <svg aria-hidden="true" class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
          </svg>
          <span id="lang-current-label">{languages[lang]}</span>
          <svg aria-hidden="true" id="lang-chevron" class="h-3 w-3 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>

        <div
          id="lang-menu"
          class="fc-surface absolute right-0 z-50 mt-1 hidden max-h-[70vh] min-w-36 overflow-y-auto p-1"
        >
          {(Object.entries(languages) as [Language, string][]).map(([code, name]) => (
            <button
              type="button"
              data-lang-option={code}
              aria-pressed={code === lang ? 'true' : 'false'}
              class={`min-h-11 w-full rounded-[0.625rem] px-3 text-left text-sm transition-colors hover:bg-[var(--surface-soft)] ${
                code === lang ? 'bg-[var(--surface-soft)] font-medium text-[var(--brand)]' : 'text-[var(--text-primary)]'
              }`}
            >
              {name}
            </button>
          ))}
        </div>
      </div>}

      <button
        id="theme-toggle-btn"
        type="button"
        class="fc-button fc-button-quiet w-11 px-0"
        aria-label={chrome.darkMode}
        aria-pressed="false"
      >
        <svg data-theme-icon="dark" aria-hidden="true" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
        </svg>
        <svg data-theme-icon="light" aria-hidden="true" class="hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
        </svg>
      </button>

      <button
        id="mobile-menu-btn"
        type="button"
        class="fc-button fc-button-quiet w-11 px-0 lg:hidden"
        aria-label={chrome.toggleMenu}
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg id="menu-open-icon" aria-hidden="true" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg id="menu-close-icon" aria-hidden="true" class="hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-[var(--border-subtle)] bg-[var(--surface-raised)] lg:hidden">
    <div class="mx-auto max-w-[88rem] px-4 py-3 sm:px-6">
      <ul class="grid gap-1 p-0">
        {navItems.map((item) => (
          <li>
            <a
              href={getNavHref(item.href)}
              data-base-href={item.href}
              data-mobile-nav-key={item.labelKey}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class={`flex min-h-11 items-center rounded-[0.625rem] px-3 font-medium transition-colors ${
                isActive(item.href)
                  ? 'bg-[var(--surface-soft)] text-[var(--brand)]'
                  : 'text-[var(--text-muted)] hover:bg-[var(--surface-soft)] hover:text-[var(--text-primary)]'
              }`}
            >
              {chrome.nav[item.labelKey]}
            </a>
          </li>
        ))}
      </ul>
      {!lockLanguage && <div class="mt-3 border-t border-[var(--border-subtle)] pt-3">
        <p id="mobile-language-label" class="mb-2 text-sm font-bold text-[var(--text-primary)]">{chrome.selectLanguage}</p>
        <div class="grid max-h-56 grid-cols-2 gap-1 overflow-y-auto sm:grid-cols-3">
          {(Object.entries(languages) as [Language, string][]).map(([code, name]) => (
            <button
              type="button"
              data-lang-mobile-option={code}
              aria-pressed={code === lang ? 'true' : 'false'}
              class={`min-h-11 rounded-[0.625rem] border border-[var(--border-subtle)] px-3 text-left text-sm transition-colors ${
                code === lang
                  ? 'bg-[var(--surface-soft)] font-medium text-[var(--brand)]'
                  : 'text-[var(--text-muted)] hover:bg-[var(--surface-soft)] hover:text-[var(--text-primary)]'
              }`}
            >
              {name}
            </button>
          ))}
        </div>
      </div>}
    </div>
  </div>
</header>

<script define:vars={{ navTranslations, darkModeTranslations, selectLanguageTranslations, toggleMenuTranslations, primaryNavigationTranslations, languages, lang, lockLanguage, supportedLanguagePattern }} is:inline>
  (() => {
    const langSupportedPaths = ['/', '/tools', '/anonymous-chat', '/games'];
    const gameLanguages = new Set(['ko', 'en', 'ja']);
    const languagePrefixPattern = new RegExp('^/(' + supportedLanguagePattern + ')(?=/|$|[?#])');

    function getBasePath(pathname) {
      const withoutLanguage = pathname.replace(languagePrefixPattern, '');
      return withoutLanguage.startsWith('/') ? withoutLanguage : '/' + withoutLanguage;
    }

    function supportsLangRouting(pathname) {
      const basePath = getBasePath(pathname);
      const pathOnly = basePath.split(/[?#]/, 1)[0];
      return langSupportedPaths.some((path) => path === '/'
        ? pathOnly === '/'
        : pathOnly === path || pathOnly.startsWith(path + '/'));
    }

    function buildLangUrl(pathname, lang) {
      const basePath = getBasePath(pathname);
      if (!supportsLangRouting(basePath)) return basePath;
      const pathOnly = basePath.split(/[?#]/, 1)[0];
      const routeLang = (pathOnly === '/games' || pathOnly.startsWith('/games/')) && !gameLanguages.has(lang)
        ? 'en'
        : lang;
      return '/' + routeLang + basePath;
    }

    function getCurrentLanguage() {
      if (lockLanguage) return lang;

      const urlMatch = window.location.pathname.match(languagePrefixPattern);
      if (urlMatch && languages[urlMatch[1]]) {
        localStorage.setItem('lang', urlMatch[1]);
        return urlMatch[1];
      }

      const stored = localStorage.getItem('lang');
      if (stored && languages[stored]) return stored;

      const browserLang = navigator.language.split('-')[0];
      if (languages[browserLang]) return browserLang;

      return 'ko';
    }

    function updateNavLabels(lang) {
      document.querySelectorAll('[data-nav-key]').forEach((element) => {
        const key = element.getAttribute('data-nav-key');
        if (!key || !navTranslations[key]) return;
        element.textContent = navTranslations[key][lang] || navTranslations[key].ko;
      });

      document.querySelectorAll('[data-mobile-nav-key]').forEach((element) => {
        const key = element.getAttribute('data-mobile-nav-key');
        if (!key || !navTranslations[key]) return;
        element.textContent = navTranslations[key][lang] || navTranslations[key].ko;
      });
    }

    function updateNavHrefs(lang) {
      document.querySelectorAll('a[data-base-href]').forEach((element) => {
        const baseHref = element.getAttribute('data-base-href');
        if (!baseHref) return;
        element.setAttribute('href', buildLangUrl(baseHref, lang));
      });
    }

    function updateLanguageUi(lang) {
      currentLanguage = lang;
      const langCurrentLabel = document.getElementById('lang-current-label');
      if (langCurrentLabel) {
        langCurrentLabel.textContent = languages[lang] || languages.ko;
      }

      const primaryNavigation = document.getElementById('primary-navigation');
      if (primaryNavigation) {
        primaryNavigation.setAttribute('aria-label', primaryNavigationTranslations[lang] || primaryNavigationTranslations.ko);
      }

      const langTrigger = document.getElementById('lang-trigger');
      if (langTrigger) {
        langTrigger.setAttribute('aria-label', selectLanguageTranslations[lang] || selectLanguageTranslations.ko);
      }

      const mobileLanguageLabel = document.getElementById('mobile-language-label');
      if (mobileLanguageLabel) {
        mobileLanguageLabel.textContent = selectLanguageTranslations[lang] || selectLanguageTranslations.ko;
      }

      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      if (mobileMenuBtn) {
        mobileMenuBtn.setAttribute('aria-label', toggleMenuTranslations[lang] || toggleMenuTranslations.ko);
      }

      const themeToggleBtn = document.getElementById('theme-toggle-btn');
      if (themeToggleBtn) {
        themeToggleBtn.setAttribute('aria-label', darkModeTranslations[lang] || darkModeTranslations.ko);
      }

      document.querySelectorAll('[data-lang-option]').forEach((button) => {
        const code = button.getAttribute('data-lang-option');
        if (code === lang) {
          button.classList.add('bg-[var(--surface-soft)]', 'font-medium', 'text-[var(--brand)]');
          button.classList.remove('text-[var(--text-primary)]');
          button.setAttribute('aria-pressed', 'true');
        } else {
          button.classList.remove('bg-[var(--surface-soft)]', 'font-medium', 'text-[var(--brand)]');
          button.classList.add('text-[var(--text-primary)]');
          button.setAttribute('aria-pressed', 'false');
        }
      });

      document.querySelectorAll('[data-lang-mobile-option]').forEach((button) => {
        const code = button.getAttribute('data-lang-mobile-option');
        if (code === lang) {
          button.classList.add('bg-[var(--surface-soft)]', 'font-medium', 'text-[var(--brand)]');
          button.classList.remove('text-[var(--text-muted)]');
          button.setAttribute('aria-pressed', 'true');
        } else {
          button.classList.remove('bg-[var(--surface-soft)]', 'font-medium', 'text-[var(--brand)]');
          button.classList.add('text-[var(--text-muted)]');
          button.setAttribute('aria-pressed', 'false');
        }
      });
    }

    function closeLanguageMenu() {
      const langMenu = document.getElementById('lang-menu');
      const langChevron = document.getElementById('lang-chevron');
      const langTrigger = document.getElementById('lang-trigger');
      if (langMenu) langMenu.classList.add('hidden');
      if (langChevron) langChevron.classList.remove('rotate-180');
      if (langTrigger) langTrigger.setAttribute('aria-expanded', 'false');
    }

    function closeMobileMenu() {
      const mobileMenu = document.getElementById('mobile-menu');
      const menuOpenIcon = document.getElementById('menu-open-icon');
      const menuCloseIcon = document.getElementById('menu-close-icon');
      if (mobileMenu) mobileMenu.classList.add('hidden');
      if (menuOpenIcon) menuOpenIcon.classList.remove('hidden');
      if (menuCloseIcon) menuCloseIcon.classList.add('hidden');
      if (mobileMenuBtn) mobileMenuBtn.setAttribute('aria-expanded', 'false');
    }

    function applyLanguage(lang) {
      localStorage.setItem('lang', lang);
      updateNavLabels(lang);
      updateNavHrefs(lang);
      updateLanguageUi(lang);
      window.dispatchEvent(new CustomEvent('languageChange', { detail: lang }));

      const currentPath = window.location.pathname + window.location.search + window.location.hash;
      if (supportsLangRouting(currentPath)) {
        const newUrl = buildLangUrl(currentPath, lang);
        if (newUrl !== currentPath) {
          window.location.href = newUrl;
        }
      }
    }

    let currentLanguage = getCurrentLanguage();
    updateNavLabels(currentLanguage);
    updateNavHrefs(currentLanguage);
    updateLanguageUi(currentLanguage);

    const langTrigger = document.getElementById('lang-trigger');
    const langMenu = document.getElementById('lang-menu');
    const langChevron = document.getElementById('lang-chevron');
    const langSelector = document.getElementById('lang-selector');

    if (langTrigger && langMenu) {
      langTrigger.addEventListener('click', (event) => {
        event.preventDefault();
        closeMobileMenu();
        langMenu.classList.toggle('hidden');
        if (langChevron) langChevron.classList.toggle('rotate-180');
        langTrigger.setAttribute('aria-expanded', String(!langMenu.classList.contains('hidden')));
      });
    }

    document.addEventListener('click', (event) => {
      if (!langSelector || !langMenu || langMenu.classList.contains('hidden')) return;
      if (!langSelector.contains(event.target)) {
        closeLanguageMenu();
      }
    });

    document.querySelectorAll('[data-lang-option]').forEach((button) => {
      button.addEventListener('click', () => {
        const code = button.getAttribute('data-lang-option');
        if (!code || !languages[code]) return;
        closeLanguageMenu();
        applyLanguage(code);
      });
    });

    document.querySelectorAll('[data-lang-mobile-option]').forEach((button) => {
      button.addEventListener('click', () => {
        const code = button.getAttribute('data-lang-mobile-option');
        if (!code || !languages[code]) return;
        closeMobileMenu();
        applyLanguage(code);
      });
    });

    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuOpenIcon = document.getElementById('menu-open-icon');
    const menuCloseIcon = document.getElementById('menu-close-icon');

    if (mobileMenuBtn && mobileMenu) {
      mobileMenuBtn.addEventListener('click', () => {
        closeLanguageMenu();
        const isHidden = mobileMenu.classList.toggle('hidden');
        if (menuOpenIcon) menuOpenIcon.classList.toggle('hidden', !isHidden);
        if (menuCloseIcon) menuCloseIcon.classList.toggle('hidden', isHidden);
        mobileMenuBtn.setAttribute('aria-expanded', String(!isHidden));
      });
    }

    document.querySelectorAll('#mobile-menu a[data-base-href]').forEach((link) => {
      link.addEventListener('click', () => {
        closeMobileMenu();
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;

      const languageWasOpen = langMenu && !langMenu.classList.contains('hidden');
      const mobileWasOpen = mobileMenu && !mobileMenu.classList.contains('hidden');
      closeLanguageMenu();
      closeMobileMenu();
      if (languageWasOpen && langTrigger) langTrigger.focus();
      if (mobileWasOpen && mobileMenuBtn) mobileMenuBtn.focus();
    });

    const themeToggleBtn = document.getElementById('theme-toggle-btn');
    const darkThemeIcon = document.querySelector('[data-theme-icon="dark"]');
    const lightThemeIcon = document.querySelector('[data-theme-icon="light"]');
    const themeMedia = window.matchMedia('(prefers-color-scheme: dark)');

    function applyTheme(isDark) {
      document.documentElement.classList.toggle('dark', isDark);
      if (themeToggleBtn) {
        themeToggleBtn.setAttribute('aria-pressed', String(isDark));
        themeToggleBtn.setAttribute('aria-label', darkModeTranslations[currentLanguage] || darkModeTranslations.ko);
      }
      if (darkThemeIcon) darkThemeIcon.classList.toggle('hidden', isDark);
      if (lightThemeIcon) lightThemeIcon.classList.toggle('hidden', !isDark);
    }

    const storedTheme = localStorage.getItem('theme');
    applyTheme(storedTheme ? storedTheme === 'dark' : themeMedia.matches);

    if (themeToggleBtn) {
      themeToggleBtn.addEventListener('click', () => {
        const isDark = !document.documentElement.classList.contains('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        applyTheme(isDark);
      });
    }

    themeMedia.addEventListener('change', (event) => {
      if (localStorage.getItem('theme')) return;
      applyTheme(event.matches);
    });
  })();
</script>
